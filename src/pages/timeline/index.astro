---
import Filters from '../../components/Filters.astro';
import Timeline from '../../components/Timeline.astro';
import Base from '../../layouts/Base.astro';
import { currentOwners, href, label, loadCatalog, plural, type Brand } from '../../lib/catalog';
import { sectionsOf } from '../../lib/timeline';

const { brands, groups, ownerName } = await loadCatalog(Astro.request);
// Brands a group owns now are drawn on that group's page; this page keeps the rest.
const sections = sectionsOf(brands, groups, ownerName, (group) => href(`/ownership-groups/${group.id}/`)).filter(
  ({ group }) => group === undefined,
);
const shownBrands = new Set(sections.flatMap(({ rows }) => rows.map((row) => row.brand.id)));
const undated = sections.reduce((sum, section) => sum + section.undated, 0);

const distinct = (values: (string | undefined)[]) => [...new Set(values.filter((value) => value !== undefined))].sort();
const options = (values: string[]) => values.map((value) => ({ value, label: label(value) }));
// The Owner filter matches the section a brand sits in: Independent, or held by another brand.
const ownerIds = (brand: Brand) => {
  const owners = currentOwners(brand);
  if (owners.length === 0) return ['independent'];
  return owners.some((owner) => owner.collection === 'brands') ? ['brands'] : [];
};
const filterData = (brand: Brand) => ({
  'data-id': brand.id,
  'data-q': brand.data.name.toLowerCase(),
  'data-owner': ownerIds(brand).join('|'),
  'data-origin': brand.data.origin,
  'data-segment': brand.data.segment,
});
---

<Base title="Timeline">
  <h1>Timeline</h1>
  <p class="lede">
    The life of each brand no group owns, from its founding to today: independents, and brands held by another brand.
    A band runs for as long as each owner held it, named where there's room; hover a band for its owner and years.
    Brands a group owns now are on <a href={href('/ownership-groups/')}>that group's page</a>.
  </p>

  <Filters
    target="timeline-rows"
    noun="brands"
    placeholder="Search brands"
    filters={[
      {
        name: 'owner',
        label: 'Owner',
        options: [
          { value: 'independent', label: 'Independent' },
          { value: 'brands', label: 'Held by another brand' },
        ],
      },
      { name: 'origin', label: 'Nation of origin', options: options(distinct(brands.filter((brand) => shownBrands.has(brand.id)).map((brand) => brand.data.origin))) },
      { name: 'segment', label: 'Segment', options: options(distinct(brands.filter((brand) => shownBrands.has(brand.id)).map((brand) => brand.data.segment))) },
    ]}
  />

  <Timeline id="timeline-rows" sections={sections} purchases={new Map()} filterData={filterData} />

  <p class="note">
    {plural(undated, 'brand')} with no years on record yet {undated === 1 ? 'is' : 'are'} left out. A purchase with no year
    is left off its brand's line.
  </p>
</Base>

<style>
  .note {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
