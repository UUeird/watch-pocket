---
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import ModelPhoto from '../../../../components/ModelPhoto.astro';
import Base from '../../../../layouts/Base.astro';
import Sources from '../../../../components/Sources.astro';
import Tiles from '../../../../components/Tiles.astro';
import { referencePhotos } from '../../../../lib/tile-photos';
import {
  describeBezel,
  describeBracelet,
  describeDial,
  formatPeriods,
  href,
  label,
  loadCatalog,
  plural,
  refHref,
  type Brand,
  type Line,
  type Model,
} from '../../../../lib/catalog';

export async function getStaticPaths() {
  const { brands, lines, models } = await loadCatalog();
  const byId = new Map(brands.map((brand) => [brand.id, brand]));
  return models.map((model) => {
    const [id, lineSlug, modelSlug] = model.id.split('/');
    const brand = brands.find((candidate) => candidate.id === id)!;
    const line = lines.find((candidate) => candidate.id === model.data.line.id)!;
    return { params: { id, line: lineSlug, model: modelSlug }, props: { model, line, brand, collaborators: model.data.collaborators.map(({ id }) => byId.get(id)!) } };
  });
}

interface Props {
  model: Model;
  line: Line;
  brand: Brand;
  collaborators: Brand[];
}

const { model, line, brand, collaborators } = Astro.props;
const { name, references, sources } = model.data;
---

<Base title={`${brand.data.name} ${name}`}>
  <Breadcrumb brand={brand} line={line} />
  <div class="head">
    <div>
      <h1>{name}</h1>
      <p class="lede">
        Model · {plural(references.length, 'reference')}
        {
          collaborators.map((collaborator) => (
            <>
              {' · with '}
              <a href={href(`/brands/${collaborator.id}/`)}>{collaborator.data.name}</a>
            </>
          ))
        }
      </p>
    </div>
    <ModelPhoto model={model} brandName={brand.data.name} />
  </div>

  <h2>References</h2>
  {references.length === 0 && <p>No references recorded yet.</p>}
  {
    references.length > 0 && (
      <Tiles
        label="References"
        tiles={references.map((reference) => ({
          href: refHref(model, reference),
          title: reference.ref,
          detail: [formatPeriods(reference.periods), reference.caseSize && `${reference.caseSize} mm`].filter(Boolean).join(' · '),
          photos: referencePhotos(model, reference, brand.data.name),
        }))}
      />
    )
  }
  {references.length > 0 && <h3>Compare references</h3>}
  <div class="table-wrap" hidden={references.length === 0}>
    <table>
      <thead>
        <tr>
          <th>Reference</th>
          <th>On sale</th>
          <th>Case</th>
          <th>Metals</th>
          <th>Case colors</th>
          <th>Bezel</th>
          <th>Crystal</th>
          <th>Movement</th>
          <th>Dials</th>
          <th>Bracelets</th>
        </tr>
      </thead>
      <tbody>
        {
          references.map((reference) => (
            <tr>
              <td class="num">
                <a href={refHref(model, reference)}>{reference.ref}</a>
              </td>
              <td class="num">{formatPeriods(reference.periods)}</td>
              <td class="num">{reference.caseSize && `${reference.caseSize} mm`}</td>
              <td class="cap">{reference.metals.map(label).join(', ')}</td>
              <td class="cap">{reference.caseColors.map(describeDial).join(', ')}</td>
              <td class="cap">{describeBezel(reference.bezel)}</td>
              <td class="cap">{reference.crystal}</td>
              <td class="num">{reference.movement}</td>
              <td class="cap">{reference.dials.map(describeDial).join(', ')}</td>
              <td class="cap">{reference.bracelets.map(describeBracelet).join(', ')}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <Sources sources={sources} />
</Base>

<style>
  /* The photo sits beside the model's name on a wide screen, and under it on a narrow one. */
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 24px;
  }
</style>
