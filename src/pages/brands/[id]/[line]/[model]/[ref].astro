---
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import ModelPhoto from '../../../../../components/ModelPhoto.astro';
import Base from '../../../../../layouts/Base.astro';
import {
  describeBezel,
  describeComplications,
  describeBracelet,
  describeDial,
  describeModelNumber,
  formatPeriods,
  label,
  loadCatalog,
  referenceName,
  refSlug,
} from '../../../../../lib/catalog';

export async function getStaticPaths() {
  const { references } = await loadCatalog(null);
  return references.map((entry) => {
    const [id, line, model] = entry.model.id.split('/');
    return { params: { id, line, model, ref: refSlug(entry.reference.ref) }, props: entry };
  });
}

const { reference, model, line, brand } = Astro.props;
const { ref, periods, price, caseSize, metals, caseColors, modelNumbers, bezel, crystal, movement, complications, dials, bracelets } = reference;
const discontinued = periods.at(-1)?.to !== undefined;
// Each fact with whether it reads from a fixed vocabulary (`rose-gold`), which is capitalized for display.
const facts: [string, string | undefined, boolean?][] = [
  ['On sale', formatPeriods(periods) || 'Not recorded'],
  ['List price', price && `${price.currency} ${price.amount.toLocaleString('en-US')} (${price.year})`],
  ['Case size', caseSize ? `${caseSize} mm` : undefined],
  ['Metals', metals.map(label).join(', '), true],
  ['Case colors', caseColors.map(describeDial).join(', '), true],
  ['Bezel', describeBezel(bezel), true],
  ['Crystal', crystal, true],
  ['Movement', movement],
  ['Complications', describeComplications(complications), true],
  ['Dials', dials.map(describeDial).join(', '), true],
  ['Bracelets', bracelets.map(describeBracelet).join(', '), true],
];
const shown = facts.filter(([, value]) => value);
---

<Base title={`${brand.data.name} ${ref}`}>
  <Breadcrumb brand={brand} line={line} model={model} />
  <div class="head">
    <div class="title">
      <h1>{ref}</h1>
      <p class="lede">{[referenceName(reference, model.data.references), 'Reference'].filter(Boolean).join(' · ')}{periods.length > 0 && (discontinued ? ' · discontinued' : ' · current')}</p>
    </div>
    <div class="photo">
      <ModelPhoto model={model} brandName={brand.data.name} reference={reference} />
    </div>
    <div class="details">
      <dl class="facts">
        {
          shown.map(([term, value, vocabulary]) => (
            <>
              <dt>{term}</dt>
              <dd class:list={{ cap: vocabulary }}>{value}</dd>
            </>
          ))
        }
      </dl>

      {
        modelNumbers.length > 0 && (
          <>
            <h2>Model numbers</h2>
            <ul>
              {modelNumbers.map((modelNumber) => (
                <li>{describeModelNumber(modelNumber)}</li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>
</Base>

<style>
  /* On a wide screen the facts sit beside the photo, under the reference number; on a narrow one the photo comes
     between the two. */
  .head {
    display: grid;
    grid-template-areas: 'title' 'photo' 'details';
    gap: 16px;
  }

  .title {
    grid-area: title;
  }

  .photo {
    grid-area: photo;
  }

  .details {
    grid-area: details;
    min-width: 0;
  }

  @media (min-width: 720px) {
    .head {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'title photo' 'details photo';
      grid-template-rows: auto 1fr;
      column-gap: 32px;
    }
  }
</style>
