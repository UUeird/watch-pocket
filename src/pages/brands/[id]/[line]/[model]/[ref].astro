---
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import ModelPhoto from '../../../../../components/ModelPhoto.astro';
import Base from '../../../../../layouts/Base.astro';
import {
  describeBezel,
  describeBracelet,
  describeDial,
  describeModelNumber,
  formatPeriods,
  label,
  loadCatalog,
  refSlug,
} from '../../../../../lib/catalog';

export async function getStaticPaths() {
  const { references } = await loadCatalog();
  return references.map((entry) => {
    const [id, line, model] = entry.model.id.split('/');
    return { params: { id, line, model, ref: refSlug(entry.reference.ref) }, props: entry };
  });
}

const { reference, model, line, brand } = Astro.props;
const { ref, periods, price, caseSize, metals, caseColors, modelNumbers, bezel, crystal, movement, dials, bracelets } = reference;
const discontinued = periods.at(-1)?.to !== undefined;
// Each fact with whether it reads from a fixed vocabulary (`rose-gold`), which is capitalized for display.
const facts: [string, string | undefined, boolean?][] = [
  ['On sale', formatPeriods(periods) || 'Not recorded'],
  ['List price', price && `${price.currency} ${price.amount.toLocaleString('en-US')} (${price.year})`],
  ['Case size', caseSize ? `${caseSize} mm` : undefined],
  ['Metals', metals.map(label).join(', '), true],
  ['Case colors', caseColors.map(describeDial).join(', '), true],
  ['Bezel', describeBezel(bezel), true],
  ['Crystal', crystal, true],
  ['Movement', movement],
  ['Dials', dials.map(describeDial).join(', '), true],
  ['Bracelets', bracelets.map(describeBracelet).join(', '), true],
];
const shown = facts.filter(([, value]) => value);
---

<Base title={`${brand.data.name} ${ref}`}>
  <Breadcrumb brand={brand} line={line} model={model} />
  <div class="head">
    <div>
      <h1>{ref}</h1>
      <p class="lede">Reference{periods.length > 0 && (discontinued ? ' · discontinued' : ' · current')}</p>
    </div>
    <ModelPhoto model={model} brandName={brand.data.name} reference={reference} />
  </div>

  <dl class="facts">
    {
      shown.map(([term, value, vocabulary]) => (
        <>
          <dt>{term}</dt>
          <dd class:list={{ cap: vocabulary }}>{value}</dd>
        </>
      ))
    }
  </dl>

  {
    modelNumbers.length > 0 && (
      <>
        <h2>Model numbers</h2>
        <ul>
          {modelNumbers.map((modelNumber) => (
            <li>{describeModelNumber(modelNumber)}</li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<style>
  /* The photo sits beside the reference number on a wide screen, and under it on a narrow one. */
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 24px;
  }
</style>
