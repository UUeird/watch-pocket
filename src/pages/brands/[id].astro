---
import Base from '../../layouts/Base.astro';
import CountryLink from '../../components/CountryLink.astro';
import Holdings from '../../components/Holdings.astro';
import Logo from '../../components/Logo.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import Tiles from '../../components/Tiles.astro';
import { linePhotos } from '../../lib/tile-photos';
import Sources from '../../components/Sources.astro';
import { brandStatus, controlNames, formatPeriods, formatStake, href, label, lineHref, loadCatalog, ownerHref, plural, type Brand } from '../../lib/catalog';

export async function getStaticPaths() {
  const { brands } = await loadCatalog(null);
  return brands.map((brand) => ({ params: { id: brand.id }, props: { brand } }));
}

interface Props {
  brand: Brand;
}

const { brand } = Astro.props;
const { brands, groupsById, ownerName, brandControl, holdingsOf, linesOf, modelsOf, collaborationsOf } = await loadCatalog(Astro.request);
const self = { collection: 'brands' as const, id: brand.id };
const holdings = holdingsOf(self);
const collaborations = collaborationsOf(brand.id);
const brandName = (modelId: string) => brands.find((other) => other.id === modelId.split('/')[0])?.data.name;
const lines = linesOf(brand.id);
const { name, origin, headquarters, manufacturing, periods, heritage, makes, segment, tags, production, copycat, website, ownership, independent, licensees, sources } =
  brand.data;
const showStake = ownership.some((record) => record.stake !== undefined);
const showBasis = ownership.some((record) => record.basis !== undefined);
const showOwnerSources = ownership.some((record) => record.sources.length > 0);
const showLicenseeSources = licensees.some((record) => record.sources.length > 0);
const control = brandControl(brand);
const descriptors = [segment, ...tags, copycat && 'copycat', brandStatus(brand)];
---

<Base title={name}>
  <Logo name={name} record={brand} />
  <h1>{name}</h1>
  <p class="lede cap">{descriptors.filter((value) => typeof value === 'string').map(label).join(' · ')}</p>

  <dl class="facts">
    {
      control && (
        <>
          <dt>Control</dt>
          <dd>
            {controlNames[control.control]}
            {control.via && `, through ${control.via}`}
          </dd>
        </>
      )
    }
    {
      makes.length > 0 && (
        <>
          <dt>Makes</dt>
          <dd>{makes.map(label).join(', ').replace(/^./, (first) => first.toUpperCase())}</dd>
        </>
      )
    }
    {
      origin && (
        <>
          <dt>Nation of origin</dt>
          <dd>
            <CountryLink country={origin} />
          </dd>
        </>
      )
    }
    {
      headquarters && (
        <>
          <dt>Headquarters</dt>
          <dd>
            <CountryLink country={headquarters} />
          </dd>
        </>
      )
    }
    {
      manufacturing.length > 0 && (
        <>
          <dt>Made in</dt>
          <dd>
            {manufacturing.map((country, index) => (
              <>
                {index > 0 && ', '}
                <CountryLink country={country} />
              </>
            ))}
          </dd>
        </>
      )
    }
    {
      periods.length > 0 && (
        <>
          <dt>Active</dt>
          <dd>{formatPeriods(periods)}</dd>
        </>
      )
    }
    {
      heritage && (
        <>
          <dt>Heritage</dt>
          <dd>
            {heritage.from}, as claimed (<SourceLinks sources={heritage.sources} />)
          </dd>
        </>
      )
    }
    {
      production && (
        <>
          <dt>Production</dt>
          <dd>
            {production.units.toLocaleString('en')} watches a year ({production.year})
          </dd>
        </>
      )
    }
    {
      website && (
        <>
          <dt>Website</dt>
          <dd>
            <a href={website}>{website}</a>
          </dd>
        </>
      )
    }
  </dl>

  {
    lines.length > 0 && (
      <>
        <h2>Product lines</h2>
        <Tiles
          label="Product lines"
          brandName={name}
          tiles={lines.map((line) => {
            const models = modelsOf(line.id);
            return {
              href: lineHref(line),
              title: line.data.name,
              detail: [models.length > 0 && plural(models.length, 'model'), formatPeriods(line.data.periods)].filter(Boolean).join(' · '),
              photos: linePhotos(models, name),
            };
          })}
        />
      </>
    )
  }

  {
    collaborations.length > 0 && (
      <>
        <h2>Collaborations</h2>
        <ul>
          {collaborations.map((model) => (
            <li>
              <a href={href(`/brands/${model.id}/`)}>{model.data.name}</a> (with {brandName(model.id)})
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>Ownership</h2>
  {
    independent && (
      <p>
        Independent today: no group or other company owns it. Source: <SourceLinks sources={independent.sources} />
      </p>
    )
  }
  {
    ownership.length === 0 ? (
      !independent && <p>No owner on record.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Owner</th>
              {showStake && <th>Stake</th>}
              <th>From</th>
              <th>To</th>
              {showBasis && <th>Basis</th>}
              {showOwnerSources && <th>Source</th>}
            </tr>
          </thead>
          <tbody>
            {ownership.map((record) => (
              <tr>
                <td>
                  <a href={ownerHref(record.owner)}>{ownerName(record.owner)}</a>
                </td>
                {showStake && <td class="num">{formatStake(record.stake)}</td>}
                <td class="num">{record.from ?? 'Unknown'}</td>
                <td class="num">{record.to ?? 'Present'}</td>
                {showBasis && <td class="cap">{record.basis}</td>}
                {showOwnerSources && (
                  <td>
                    <SourceLinks sources={record.sources} />
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    holdings.length > 0 && (
      <>
        <h2>Stakes held</h2>
        <Holdings owner={self} />
      </>
    )
  }

  {
    licensees.length > 0 && (
      <>
        <h2>Watches made under license by</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Licensee</th>
                <th>From</th>
                <th>To</th>
                {showLicenseeSources && <th>Source</th>}
              </tr>
            </thead>
            <tbody>
              {licensees.map((record) => (
                <tr>
                  <td>
                    <a href={href(`/ownership-groups/${record.licensee.id}/`)}>{groupsById.get(record.licensee.id)?.data.name}</a>
                  </td>
                  <td class="num">{record.from ?? 'Unknown'}</td>
                  <td class="num">{record.to ?? 'Present'}</td>
                  {showLicenseeSources && (
                    <td>
                      <SourceLinks sources={record.sources} />
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <Sources sources={sources} />
</Base>
