---
import BrandLogo from '../../components/BrandLogo.astro';
import CountryLink from '../../components/CountryLink.astro';
import Filters from '../../components/Filters.astro';
import FoundingChart from '../../components/FoundingChart.astro';
import Owners from '../../components/Owners.astro';
import Base from '../../layouts/Base.astro';
import { activeGroups, brandYears, controlNames, currentOwners, href, label, loadCatalog } from '../../lib/catalog';
import { measuresOf, metrics } from '../../lib/metrics';

const catalog = await loadCatalog(Astro.request);
const { brands, groups, linesOf, brandControl } = catalog;
// The table's measure column can show any per-brand figure; a count of one brand each says nothing.
const measures = measuresOf(catalog);
const columnMetrics = metrics.filter((metric) => metric.id !== 'brands');
const column = columnMetrics.find((metric) => metric.id === 'age')!;
const maxOf = (id: string) => Math.max(0, ...[...measures.values()].map(({ values }) => values[id] ?? 0));
const columnMax = maxOf(column.id);
const columnValues = Object.fromEntries([...measures].map(([id, { values }]) => [id, values]));
const distinct = (values: (string | undefined)[]) =>
  [...new Set(values.filter((value) => value !== undefined))].sort();
const segments = distinct(brands.map((brand) => brand.data.segment));
const origins = distinct(brands.map((brand) => brand.data.origin));
const makes = distinct(brands.flatMap((brand) => brand.data.makes));
const tags = distinct(brands.flatMap((brand) => brand.data.tags));
// The Owner filter lists groups, so a brand held by another brand matches none of its options.
// An independent brand matches the Independent option instead.
const groupOwnerIds = (brand: (typeof brands)[number]) =>
  brand.data.independent
    ? ['independent']
    : currentOwners(brand)
        .filter((owner) => owner.collection === 'groups')
        .map((owner) => owner.id);
const options = (values: string[]) => values.map((value) => ({ value, label: label(value) }));
---

<Base title="Brands">
  <h1>Watch brands</h1>
  <p class="lede">The names and corporations behind the world's timepieces.</p>

  <Filters
    target="brands"
    noun="brands"
    placeholder="Search brands and product lines"
    filters={[
      {
        name: 'owner',
        label: 'Owner',
        options: [
          { value: 'independent', label: 'Independent' },
          ...activeGroups(groups).map((group) => ({ value: group.id, label: group.data.name })),
        ],
      },
      { name: 'control', label: 'Control', options: Object.entries(controlNames).map(([value, name]) => ({ value, label: name })) },
      { name: 'origin', label: 'Nation of origin', options: options(origins) },
      { name: 'segment', label: 'Segment', options: options(segments) },
      { name: 'makes', label: 'Makes', options: options(makes) },
      { name: 'tags', label: 'Type', options: options(tags) },
    ]}
  />

  <FoundingChart
    brands={brands.map((brand) => ({ id: brand.id, name: brand.data.name, founded: brand.data.periods[0]?.from }))}
    follow="brands"
  />

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Brand</th>
          <th>Owner</th>
          <th>Nation of origin</th>
          <th>Years active</th>
          <th>Segment</th>
          <th class="measure-head">
            <span class="measure-controls">
              <select class="measure-select" aria-label="Figure shown in this column">
                {columnMetrics.map((metric) => <option value={metric.id} selected={metric === column}>{metric.label}</option>)}
              </select>
              <button type="button" class="measure-sort" aria-pressed="false" title="Sort by this figure, largest first">
                Sort
              </button>
            </span>
          </th>
        </tr>
      </thead>
      <tbody id="brands">
        {
          brands.map((brand) => {
            const { makes, tags, logo } = brand.data;
            const lineNames = linesOf(brand.id).map((line) => line.data.name);
            return (
              <tr
                data-id={brand.id}
                data-q={[brand.data.name, ...lineNames].join(' ').toLowerCase()}
                data-owner={groupOwnerIds(brand).join('|')}
                data-control={brandControl(brand)?.control}
                data-segment={brand.data.segment}
                data-origin={brand.data.origin}
                data-makes={makes.join('|')}
                data-tags={tags.join('|')}
              >
                <td>
                  <div class="brand">
                    {logo ? <BrandLogo record={brand} width={82} height={22} class="brand-logo" /> : <span class="brand-logo" />}
                    <a href={href(`/brands/${brand.id}/`)}>{brand.data.name}</a>
                  </div>
                </td>
                <td>
                  <Owners brand={brand} />
                </td>
                <td>{brand.data.origin && <CountryLink country={brand.data.origin} />}</td>
                <td>
                  {brandYears(brand)
                    .split(', ')
                    .map((span, index) => (
                      <>
                        {index > 0 && ', '}
                        <span class="nowrap">{span}</span>
                      </>
                    ))}
                </td>
                <td class="cap">{brand.data.segment && label(brand.data.segment)}</td>
                <td class="measure">
                  {(() => {
                    const value = measures.get(brand.id)!.values[column.id];
                    return value === undefined ? null : (
                      <>
                        <span class="bar" style={{ width: `${(value / columnMax) * 100}%` }} />
                        <span class="value">{column.format(value)}</span>
                      </>
                    );
                  })()}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Base>

<script is:inline type="application/json" id="measure-values" set:html={JSON.stringify(columnValues).replace(/</g, '\\u003c')} />

<script>
  import { metricById } from '../../lib/metrics';

  // The measure column: a bar and figure for the chosen measure, and an optional sort by it, largest first.
  const values: Record<string, Record<string, number>> = JSON.parse(document.getElementById('measure-values')!.textContent!);
  const select = document.querySelector<HTMLSelectElement>('.measure-select')!;
  const sort = document.querySelector<HTMLButtonElement>('.measure-sort')!;
  const body = document.getElementById('brands')!;
  const rows = [...body.querySelectorAll<HTMLTableRowElement>('tr[data-id]')];
  const valueOf = (row: HTMLElement, id: string) => values[row.dataset.id!]?.[id];

  const draw = () => {
    const metric = metricById(select.value);
    const max = Math.max(0, ...rows.map((row) => valueOf(row, metric.id) ?? 0));
    for (const row of rows) {
      const cell = row.querySelector<HTMLElement>('.measure')!;
      const value = valueOf(row, metric.id);
      cell.replaceChildren();
      if (value === undefined) continue;
      const bar = document.createElement('span');
      bar.className = 'bar';
      bar.style.width = `${(value / max) * 100}%`;
      const text = document.createElement('span');
      text.className = 'value';
      text.textContent = metric.format(value);
      cell.append(bar, text);
    }
    const sorted = sort.getAttribute('aria-pressed') === 'true';
    // Without a sort, rows go back to name order, which is the order they were built in.
    const order = sorted
      ? [...rows].sort((a, b) => (valueOf(b, metric.id) ?? -Infinity) - (valueOf(a, metric.id) ?? -Infinity))
      : rows;
    body.append(...order);
  };
  select.addEventListener('change', draw);
  sort.addEventListener('click', () => {
    sort.setAttribute('aria-pressed', String(sort.getAttribute('aria-pressed') !== 'true'));
    draw();
  });
</script>

<style>
  .measure-head {
    min-width: 180px;
  }

  .measure-controls {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .measure-select {
    max-width: 150px;
    padding: 2px 4px;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .measure-sort {
    padding: 2px 8px;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }

  .measure-sort[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .measure {
    position: relative;
    min-width: 180px;
  }

  /* The bar sits behind the figure, scaled to the largest figure in the whole list. */
  .measure :global(.bar) {
    position: absolute;
    top: 50%;
    left: 0;
    height: 16px;
    max-width: 100%;
    translate: 0 -50%;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 0 4px 4px 0;
  }

  .measure :global(.value) {
    position: relative;
    padding-left: 6px;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* A fixed slot, so the names line up: each logo on its fill (see src/lib/logo.ts), empty for a brand with none. */
  .brand :global(.brand-logo) {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 88px;
    height: 28px;
    padding: 3px;
  }
</style>
