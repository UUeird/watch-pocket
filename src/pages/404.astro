---
// Shown for any address the site doesn't have. GitHub Pages serves the built 404.html for every missing path, at any
// depth, so every link here is absolute.
import Base from '../layouts/Base.astro';
import { href } from '../lib/catalog';

const sections = [
  { path: '/brands/', name: 'Brands' },
  { path: '/ownership-groups/', name: 'Ownership Groups' },
  { path: '/models/', name: 'Models' },
  { path: '/references/', name: 'References' },
];
---

<Base title="Page not found">
  <section class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lede">There's nothing at this address. It may have moved, or the link may have a typo.</p>
    <a class="home" href={href('/')}>Back to the home page</a>
    <p class="browse">
      Or browse{' '}
      {sections.map(({ path, name }, index) => (
        <>
          <a href={href(path)}>{name}</a>
          {index < sections.length - 2 ? ', ' : index === sections.length - 2 ? ' or ' : '.'}
        </>
      ))}
    </p>
  </section>
</Base>

<style>
  .not-found {
    max-width: 560px;
    margin: 48px 0;
  }

  .code {
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .home {
    display: inline-block;
    padding: 8px 16px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--accent);
    border-radius: 999px;
  }

  .home:hover,
  .home:focus-visible {
    text-decoration: underline;
  }

  .browse {
    margin: 24px 0 0;
    color: var(--muted);
  }
</style>
