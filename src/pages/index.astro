---
import Base from '../layouts/Base.astro';
import { href, loadCatalog } from '../lib/catalog';

const { brands, groups, references } = await loadCatalog();
// Counts with thousands separators, and each noun's own plural.
const count = (n: number, one: string, many: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : many}`;
const countries = new Set(brands.map((brand) => brand.data.origin).filter(Boolean));
// The site's sections, each with what it holds and how big it is.
const sections = [
  {
    title: 'Brands',
    path: '/brands/',
    count: count(brands.length, 'brand', 'brands'),
    text: 'Every brand with its owner, origin and founding, sized and sorted on a treemap.',
  },
  {
    title: 'Ownership Groups',
    path: '/ownership-groups/',
    count: count(groups.length, 'group', 'groups'),
    text: 'The corporations and families that hold the brands, and how much each holds.',
  },
  {
    title: 'Countries',
    path: '/countries/',
    count: count(countries.size, 'country', 'countries'),
    text: 'Brands by the country they were founded in, whoever owns them today.',
  },
  {
    title: 'References',
    path: '/references/',
    count: count(references.length, 'reference', 'references'),
    text: 'Individual watches by reference number, with their metals, dials and bezels.',
  },
];
---

<Base>
  <h1>Who makes your watch?</h1>
  <p class="lede">The names and corporations behind the world's timepieces.</p>

  <ul class="sections">
    {
      sections.map((section) => (
        <li>
          <a href={href(section.path)}>
            <h2>{section.title}</h2>
            <span class="count">{section.count}</span>
            <p>{section.text}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .sections {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 600px) {
    .sections {
      grid-template-columns: 1fr;
    }
  }

  /* Each card is one link, so the whole card is the target. */
  .sections a {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 20px;
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .sections a:hover,
  .sections a:focus-visible {
    border-color: var(--accent);
  }

  .sections h2 {
    margin: 0;
    font-size: 1.5rem;
    color: var(--accent);
  }

  .count {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .sections p {
    margin: 8px 0 0;
  }
</style>
