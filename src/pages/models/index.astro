---
import Filters from '../../components/Filters.astro';
import Base from '../../layouts/Base.astro';
import { href, label, lineHref, loadCatalog } from '../../lib/catalog';

const { brands, lines, models } = await loadCatalog(Astro.request);
// Grouped by brand, then line, then model name, with numbers in number order.
const rows = models
  .map((model) => {
    const line = lines.find((candidate) => candidate.id === model.data.line.id)!;
    const brand = brands.find((candidate) => candidate.id === line.data.brand.id)!;
    return { model, line, brand };
  })
  .sort(
    (a, b) =>
      a.brand.data.name.localeCompare(b.brand.data.name) ||
      a.line.data.name.localeCompare(b.line.data.name, 'en', { numeric: true }) ||
      a.model.data.name.localeCompare(b.model.data.name, 'en', { numeric: true }),
  );
const distinct = (values: (string | undefined)[]) => [...new Set(values.filter((value) => value !== undefined))].sort();
const options = (values: string[]) => values.map((value) => ({ value, label: label(value) }));
// The years a model was on sale, from its first reference's release to its last one's end.
const years = (model: (typeof models)[number]) => {
  const periods = model.data.references.flatMap((reference) => reference.periods);
  if (periods.length === 0) return undefined;
  const from = Math.min(...periods.map((period) => period.from));
  const to = periods.some((period) => period.to === undefined) ? 'present' : Math.max(...periods.map((period) => period.to!));
  return `${from}–${to}`;
};
---

<Base title="Models">
  <h1>Models</h1>
  <p class="lede">Every model on record, each one named design within a line.</p>

  <Filters
    target="models"
    noun="models"
    placeholder="Search models"
    filters={[
      { name: 'brand', label: 'Brand', options: distinct(rows.map(({ brand }) => brand.data.name)).map((name) => ({ value: name, label: name })) },
      { name: 'style', label: 'Style', options: options(distinct(models.map((model) => model.data.style))) },
      { name: 'theme', label: 'Theme', options: options(distinct(models.map((model) => model.data.theme))) },
    ]}
  />

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Brand</th>
          <th>Line</th>
          <th>On sale</th>
          <th>Style</th>
          <th>Theme</th>
          <th>References</th>
        </tr>
      </thead>
      <tbody id="models">
        {
          rows.map(({ model, line, brand }) => (
            <tr
              data-q={`${model.data.name} ${line.data.name} ${brand.data.name}`.toLowerCase()}
              data-brand={brand.data.name}
              data-style={model.data.style}
              data-theme={model.data.theme}
            >
              <td>
                <a href={href(`/brands/${model.id}/`)}>{model.data.name}</a>
              </td>
              <td>
                <a href={href(`/brands/${brand.id}/`)}>{brand.data.name}</a>
              </td>
              <td>
                <a href={lineHref(line)}>{line.data.name}</a>
              </td>
              <td class="num">{years(model)}</td>
              <td class="cap">{model.data.style && label(model.data.style)}</td>
              <td class="cap">{model.data.theme && label(model.data.theme)}</td>
              <td class="num">{model.data.references.length}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>
