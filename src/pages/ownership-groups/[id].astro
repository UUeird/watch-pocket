---
import Base from '../../layouts/Base.astro';
import Holdings from '../../components/Holdings.astro';
import Logo from '../../components/Logo.astro';
import Sources from '../../components/Sources.astro';
import { describeControl, href, loadCatalog, type Group } from '../../lib/catalog';
import { countries } from '../../lib/countries';

export async function getStaticPaths() {
  const { groups } = await loadCatalog();
  return groups.map((group) => ({ params: { id: group.id }, props: { group } }));
}

interface Props {
  group: Group;
}

const { group } = Astro.props;
const { groups, groupsById, holdingsOf, licensesOf } = await loadCatalog();
const subsidiaries = groups.filter((other) => other.data.parent?.id === group.id);
const { name, country, founded, dissolved, website, parent, sources } = group.data;
const { flag } = countries[country];
const owner = { collection: 'groups' as const, id: group.id };
const holdings = holdingsOf(owner);
const current = holdings.filter((record) => record.to === undefined);
const former = holdings.filter((record) => record.to !== undefined);
const licenses = licensesOf(group.id);
---

<Base title={name}>
  <Logo name={name} record={group} />
  <h1>{name}</h1>
  <p class="lede">{describeControl(group)}</p>

  <dl class="facts">
    <dt>Country</dt>
    <dd>{flag && <span aria-hidden="true">{flag} </span>}{country}</dd>
    {
      founded && (
        <>
          <dt>Founded</dt>
          <dd>{founded}</dd>
        </>
      )
    }
    {
      dissolved && (
        <>
          <dt>Dissolved</dt>
          <dd>{dissolved}</dd>
        </>
      )
    }
    {
      parent && (
        <>
          <dt>Parent</dt>
          <dd>
            <a href={href(`/ownership-groups/${parent.id}/`)}>{groupsById.get(parent.id)?.data.name}</a>
          </dd>
        </>
      )
    }
    {
      website && (
        <>
          <dt>Website</dt>
          <dd>
            <a href={website}>{website}</a>
          </dd>
        </>
      )
    }
  </dl>

  {
    subsidiaries.length > 0 && (
      <>
        <h2>Companies owned</h2>
        <ul>
          {subsidiaries.map((subsidiary) => (
            <li>
              <a href={href(`/ownership-groups/${subsidiary.id}/`)}>{subsidiary.data.name}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {holdings.length === 0 && (
    <>
      <h2>Brands</h2>
      <p>No brands on record.</p>
    </>
  )}
  {
    current.length > 0 && (
      <>
        <h2>Brands</h2>
        <Holdings owner={owner} only="current" />
      </>
    )
  }
  {
    former.length > 0 && (
      <>
        <h2>Formerly held</h2>
        <p class="section-note">
          {dissolved !== undefined
            ? `Brands ${name} held before it was dissolved in ${dissolved}, and the years it held each.`
            : `Brands ${name} once held and has since sold, closed or lost, and the years it held each.`}
        </p>
        <Holdings owner={owner} only="former" />
      </>
    )
  }

  {
    licenses.length > 0 && (
      <>
        <h2>Brands made under license</h2>
        <ul>
          {licenses.map((brand) => (
            <li>
              <a href={href(`/brands/${brand.id}/`)}>{brand.data.name}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <Sources sources={sources} />
</Base>

<style>
  .section-note {
    margin: -4px 0 12px;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
