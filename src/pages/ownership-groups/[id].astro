---
import Base from '../../layouts/Base.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import Sources from '../../components/Sources.astro';
import { countryHref, formatStake, label, loadCatalog, type Group } from '../../lib/catalog';

export async function getStaticPaths() {
  const { groups } = await loadCatalog();
  return groups.map((group) => ({ params: { id: group.id }, props: { group } }));
}

interface Props {
  group: Group;
}

const { group } = Astro.props;
const { brands, groups, groupsById } = await loadCatalog();
const subsidiaries = groups.filter((other) => other.data.parent?.id === group.id);
const { name, country, type, founded, website, parent, sources } = group.data;
const holdings = brands
  .flatMap((brand) =>
    brand.data.ownership
      .filter((record) => record.owner.id === group.id)
      .map((record) => ({ brand, ...record })),
  )
  .sort((a, b) => Number(a.to !== undefined) - Number(b.to !== undefined));
const showStake = holdings.some((record) => record.stake !== undefined);
const showBasis = holdings.some((record) => record.basis !== undefined);
const showHoldingSources = holdings.some((record) => record.sources.length > 0);
const licenses = brands.filter((brand) =>
  brand.data.licensees.some((record) => record.licensee.id === group.id && record.to === undefined),
);
---

<Base title={name}>
  <h1>{name}</h1>
  <p class="lede cap">{label(type)}</p>

  <dl class="facts">
    <dt>Country</dt>
    <dd>{country}</dd>
    {
      founded && (
        <>
          <dt>Founded</dt>
          <dd>{founded}</dd>
        </>
      )
    }
    {
      parent && (
        <>
          <dt>Parent</dt>
          <dd>
            <a href={`/ownership-groups/${parent.id}/`}>{groupsById.get(parent.id)?.data.name}</a>
          </dd>
        </>
      )
    }
    {
      website && (
        <>
          <dt>Website</dt>
          <dd>
            <a href={website}>{website}</a>
          </dd>
        </>
      )
    }
  </dl>

  {
    subsidiaries.length > 0 && (
      <>
        <h2>Companies owned</h2>
        <ul>
          {subsidiaries.map((subsidiary) => (
            <li>
              <a href={`/ownership-groups/${subsidiary.id}/`}>{subsidiary.data.name}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>Brands</h2>
  {
    holdings.length === 0 ? (
      <p>No brands on record.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Brand</th>
              <th>Origin</th>
              {showStake && <th>Stake</th>}
              <th>Held from</th>
              <th>To</th>
              {showBasis && <th>Basis</th>}
              {showHoldingSources && <th>Source</th>}
            </tr>
          </thead>
          <tbody>
            {holdings.map(({ brand, stake, basis, from, to, sources }) => (
              <tr>
                <td>
                  <a href={`/brands/${brand.id}/`}>{brand.data.name}</a>
                </td>
                <td>{brand.data.origin && <a href={countryHref(brand.data.origin)}>{brand.data.origin}</a>}</td>
                {showStake && <td class="num">{formatStake(stake)}</td>}
                <td class="num">{from ?? 'Unknown'}</td>
                <td class="num">{to ?? 'Present'}</td>
                {showBasis && <td class="cap">{basis}</td>}
                {showHoldingSources && (
                  <td>
                    <SourceLinks sources={sources} />
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    licenses.length > 0 && (
      <>
        <h2>Brands made under license</h2>
        <ul>
          {licenses.map((brand) => (
            <li>
              <a href={`/brands/${brand.id}/`}>{brand.data.name}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <Sources sources={sources} />
</Base>
