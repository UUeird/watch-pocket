---
import Filters from '../../components/Filters.astro';
import FlagBadge from '../../components/FlagBadge.astro';
import OwnershipTimeline from '../../components/OwnershipTimeline.astro';
import Treemap from '../../components/Treemap.astro';
import Base from '../../layouts/Base.astro';
import { describeControl, formatStake, href, label, loadCatalog, plural, type Brand, type Group } from '../../lib/catalog';
import { chartData } from '../../lib/chart-data';

const catalog = await loadCatalog();
const { groups, brandsOf, licensesOf, holdingsOf } = catalog;
const data = chartData(catalog, { groupsOnly: true });
const holdings = groups.map((group) => ({ group, records: holdingsOf({ collection: 'groups', id: group.id }) }));

// A brand as it sits in a group: owned outright, owned in part (with the stake), or made under license.
type Tile = { brand: Brand; stake?: number | 'unknown'; licensed?: boolean };

const held = groups
  .map((group) => {
    const owned: Tile[] = brandsOf(group.id).map((brand) => ({
      brand,
      stake: brand.data.ownership.find((record) => record.to === undefined && record.owner.id === group.id)?.stake,
    }));
    const licensed: Tile[] = licensesOf(group.id).map((brand) => ({ brand, licensed: true }));
    return { group, owned, licensed, tiles: [...owned, ...licensed] };
  })
  .sort((a, b) => b.owned.length - a.owned.length || b.licensed.length - a.licensed.length);

// Sizes a logo to cover roughly `area` square pixels, within a height range, so a square mark
// is not dwarfed by a long wordmark. Returns the display height in pixels.
const logoHeight = ({ width, height }: { width: number; height: number }, area: number, max: number) =>
  Math.round(Math.min(max, Math.max(10, Math.sqrt(area / (width / height)))));

// Up to two initials, standing in for a brand with no logo file, e.g. `Harry Winston` → `HW`.
const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .map((word) => word.match(/\p{L}/u)?.[0] ?? '')
    .join('')
    .slice(0, 2)
    .toUpperCase();

// The filters work on each brand tile, by the brand's own fields and its group's, so a card shows the brands that
// match and hides when none do. A brand searches by its name and its group's.
const controlOf = (group: Group) => (group.data.parent || !group.data.control ? 'subsidiary' : group.data.control);
const distinct = (values: (string | undefined)[]) => [...new Set(values.filter((value) => value !== undefined))].sort();
const tileBrands = held.flatMap(({ tiles }) => tiles.map(({ brand }) => brand));
const options = (values: string[]) => values.map((value) => ({ value, label: label(value) }));
const controls = distinct(groups.map(controlOf)).map((value) => ({
  value,
  label: describeControl(groups.find((group) => controlOf(group) === value)!),
}));
const filterData = (group: Group, brand: Brand) => ({
  'data-id': brand.id,
  'data-q': [brand.data.name, group.data.name].join(' ').toLowerCase(),
  'data-country': group.data.country,
  'data-control': controlOf(group),
  'data-segment': brand.data.segment,
  'data-origin': brand.data.origin,
  'data-makes': brand.data.makes.join('|'),
  'data-tags': brand.data.tags.join('|'),
});

const stakeNote = (stake: Tile['stake']) =>
  stake === 'unknown' ? 'Part-owned, stake unknown' : `${formatStake(stake)} stake`;
---

<Base title="Ownership Groups">
  <h1>Ownership groups</h1>
  <p class="lede">Groups and corporations, with the brands each currently holds.</p>

  <Filters
    target="group-cards"
    noun="brands"
    placeholder="Search groups and brands"
    filters={[
      { name: 'country', label: 'Group based in', options: options(distinct(groups.map((group) => group.data.country))) },
      { name: 'control', label: 'Control', options: controls },
      { name: 'origin', label: 'Brand origin', options: options(distinct(tileBrands.map((brand) => brand.data.origin))) },
      { name: 'segment', label: 'Segment', options: options(distinct(tileBrands.map((brand) => brand.data.segment))) },
      { name: 'makes', label: 'Makes', options: options(distinct(tileBrands.flatMap((brand) => brand.data.makes))) },
      { name: 'tags', label: 'Type', options: options(distinct(tileBrands.flatMap((brand) => brand.data.tags))) },
    ]}
  />

  <Treemap id="groups" title="Ownership groups" data={data} follow="group-cards" />
  <OwnershipTimeline holdings={holdings} />

  <h2 class="section-heading">All groups</h2>
  <ul class="legend" aria-label="Key">
    <li><span class="key-tile" /> Owned outright</li>
    <li><span class="key-tile"><span class="stake">49%</span></span> Part-owned, with the group's stake</li>
    <li><span class="key-tile licensed" /> Made under license, not owned</li>
  </ul>

  <p class="order-note" data-order-note>Largest first, by number of brands.</p>
  <div class="cards" id="group-cards">
    {
      held.map(({ group, owned, licensed, tiles }, index) => (
        <section class="card" data-group={group.id} data-index={index} data-filter-group>
          {group.data.logo && (
            <div class="card-logo">
              <img
                src={group.data.logo.src}
                width={group.data.logo.width}
                height={group.data.logo.height}
                style={{ height: `${logoHeight(group.data.logo, 3600, 44)}px` }}
                alt=""
                loading="lazy"
              />
            </div>
          )}
          <div class="card-head">
            <h2>
              <a href={href(`/ownership-groups/${group.id}/`)}>{group.data.name}</a>
            </h2>
            <FlagBadge country={group.data.country} />
          </div>
          <p class="measure" data-measure hidden />
          <p class="meta">
            {describeControl(group)} · {plural(owned.length, 'brand')}
            {licensed.length > 0 && ` · ${licensed.length} licensed`}
          </p>
          {tiles.length > 0 && (
            <ul class="tiles">
              {tiles.map(({ brand, stake, licensed }) => (
                <li {...filterData(group, brand)}>
                  <a class:list={['tile', { licensed }]} href={href(`/brands/${brand.id}/`)}>
                    <span class="plate">
                      {brand.data.logo ? (
                        <img
                          src={brand.data.logo.src}
                          width={brand.data.logo.width}
                          height={brand.data.logo.height}
                          style={{ height: `${logoHeight(brand.data.logo, 1500, 40)}px` }}
                          alt=""
                          loading="lazy"
                        />
                      ) : (
                        <span class="monogram" aria-hidden="true">
                          {initials(brand.data.name)}
                        </span>
                      )}
                      {stake !== undefined && (
                        <span class="stake" title={stakeNote(stake)} aria-hidden="true">
                          {stake === 'unknown' ? 'Part' : `${stake}%`}
                        </span>
                      )}
                    </span>
                    <span class="tile-name">
                      {brand.data.name}
                      {stake !== undefined && <span class="visually-hidden">, {stakeNote(stake)}</span>}
                      {licensed && <span class="visually-hidden">, made under license</span>}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { metricById } from '../../lib/treemap';

  // The cards follow the treemap above: largest first by whatever it is sized by, with each group's figure shown.
  const cards = [...document.querySelectorAll<HTMLElement>('.card[data-group]')];
  const note = document.querySelector<HTMLElement>('[data-order-note]')!;
  const treemap = document.querySelector<HTMLElement>('[data-treemap]');
  const follow = () => {
    if (!treemap?.dataset.totals) return;
    const size = treemap.dataset.size!;
    const totals: Record<string, number> = JSON.parse(treemap.dataset.totals);
    const { format } = metricById(size);
    const ranked = [...cards].sort(
      (a, b) =>
        (totals[b.dataset.group!] ?? -1) - (totals[a.dataset.group!] ?? -1) || Number(a.dataset.index) - Number(b.dataset.index),
    );
    // Moved in the page rather than reordered by CSS, so tabbing goes in the order shown.
    cards[0]?.parentElement?.append(...ranked);
    for (const card of cards) {
      const measure = card.querySelector<HTMLElement>('[data-measure]')!;
      const total = totals[card.dataset.group!];
      // The brand count is already in each card's summary line.
      measure.hidden = size === 'brands';
      measure.textContent = total === undefined ? 'No figure yet' : format(total);
      measure.classList.toggle('unknown', total === undefined);
    }
    const label = metricById(size).label.toLowerCase();
    note.textContent = `Largest first, by ${label}, as in the chart above.`;
  };
  treemap?.addEventListener('treemap:layout', follow);
  follow();
</script>

<style>
  .order-note {
    margin: -8px 0 16px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .measure {
    margin: 4px 0 0;
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }

  .measure.unknown {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .section-heading {
    margin: 0 0 12px;
    font-size: 1.25rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0 0 20px;
    padding: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .key-tile {
    position: relative;
    width: 34px;
    height: 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .key-tile .stake {
    top: -7px;
    right: -9px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    align-items: start;
    gap: 16px;
  }

  .card {
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  /* Logos are drawn for a light page, so each sits on a white plate in both color schemes. */
  .card-logo {
    display: inline-flex;
    margin-bottom: 10px;
    padding: 4px 6px;
    background: #ffffff;
    border-radius: 3px;
  }

  /* Each logo's height is set inline; a very long wordmark is capped by width instead. */
  .card-logo img {
    width: auto;
    max-width: 180px;
    object-fit: contain;
    object-position: left;
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .card h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .meta {
    margin: 4px 0 12px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    transition: border-color 0.15s;
  }

  /* A dashed edge marks a brand the group makes under license rather than owns. */
  .licensed {
    border: 1.5px dashed var(--muted);
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: var(--accent);
  }

  .plate {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 6px 8px;
    background: #ffffff;
  }

  .plate img {
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* A brand with no logo file shows its initials in place of one. */
  .monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    font-family: Georgia, serif;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: #6b6860;
    border: 1px solid #d4d0c6;
    border-radius: 50%;
  }

  .stake {
    position: absolute;
    top: 3px;
    right: 3px;
    padding: 1px 5px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.4;
    /* The page background reads against the accent in both color schemes. */
    color: var(--bg);
    background: var(--accent);
    border-radius: 999px;
  }

  .tile-name {
    padding: 4px 6px 5px;
    font-size: 0.75rem;
    line-height: 1.25;
    text-align: center;
    border-top: 1px solid var(--line);
  }

  .tile:hover .tile-name,
  .tile:focus-visible .tile-name {
    color: var(--accent);
    text-decoration: underline;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
