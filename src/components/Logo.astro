---
import type { CollectionEntry } from 'astro:content';
import BrandLogo from './BrandLogo.astro';

interface Props {
  name: string;
  record: CollectionEntry<'brands'> | CollectionEntry<'groups'>;
}

const { name, record } = Astro.props;
const { data } = record;
const { logo } = data;
// The logo's credit, then those of its parts taken from other files, which are shown in its place where it is small.
const credits = [
  { label: 'Logo', credit: data.logoCredit },
  { label: 'Logomark', credit: data.logomark && data.logomarkCredit },
  { label: 'Wordmark', credit: data.wordmark && data.wordmarkCredit },
].filter((entry) => logo && entry.credit);
---

{logo && <BrandLogo record={record} width={216} height={72} class="logo" alt={`${name} logo`} loading="eager" />}
{
  credits.map(({ label, credit }) => (
    <p class="logo-credit">
      {label}
      {credit!.author && ` by ${credit!.author}`} · {credit!.licenseUrl ? <a href={credit!.licenseUrl}>{credit!.license}</a> : credit!.license} ·{' '}
      <a href={credit!.source}>Source</a>
    </p>
  ))
}
