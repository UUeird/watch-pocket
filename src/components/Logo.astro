---
import type { CollectionEntry } from 'astro:content';

type Data = CollectionEntry<'brands' | 'groups'>['data'];

interface Props {
  name: string;
  data: Pick<Data, 'logo' | 'logoCredit' | 'logomark' | 'logomarkCredit' | 'wordmark' | 'wordmarkCredit' | 'logoOnDark' | 'logoOnDarkCredit' | 'logomarkOnDark' | 'logomarkOnDarkCredit'>;
}

const { name, data } = Astro.props;
const { logo } = data;
// The logo's credit, then those of its parts taken from other files, which charts show in its place.
const credits = [
  { label: 'Logo', credit: data.logoCredit },
  { label: 'Logomark', credit: data.logomark && data.logomarkCredit },
  { label: 'Wordmark', credit: data.wordmark && data.wordmarkCredit },
  { label: 'Logo for dark backgrounds', credit: data.logoOnDark && data.logoOnDarkCredit },
  { label: 'Logomark for dark backgrounds', credit: data.logomarkOnDark && data.logomarkOnDarkCredit },
].filter((entry) => logo && entry.credit);
---

{logo && <img class="logo" src={logo.src} width={logo.width} height={logo.height} alt={`${name} logo`} />}
{
  credits.map(({ label, credit }) => (
    <p class="logo-credit">
      {label}
      {credit!.author && ` by ${credit!.author}`} · {credit!.licenseUrl ? <a href={credit!.licenseUrl}>{credit!.license}</a> : credit!.license} ·{' '}
      <a href={credit!.source}>Source</a>
    </p>
  ))
}
