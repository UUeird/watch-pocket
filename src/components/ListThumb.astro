---
// A small preview at the start of a list row: the item's first photo, linking to its page. One with none, or whose
// maker's image fails to load, shows a plain watch. Credits go under the list (see PhotoCredits.astro).
import { Image } from 'astro:assets';
import type { TilePhoto } from '../lib/tile-photos';

interface Props {
  href: string;
  photos: TilePhoto[];
}

const { href, photos } = Astro.props;
const photo = photos[0];
---

<a class="thumb" href={href} tabindex="-1" aria-hidden="true">
  {
    photo &&
      ('file' in photo ? (
        <Image class="fill" src={photo.file} alt="" widths={[48, 96]} sizes="48px" loading="lazy" />
      ) : (
        <img src={photo.src} alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()" />
      ))
  }
  <svg class="blank" viewBox="0 0 48 48">
    <path d="M18 4h12l2 9M18 4l-2 9M18 44h12l2-9M18 44l-2-9" />
    <circle cx="24" cy="24" r="12" />
    <path d="M24 17v7l5 3" />
  </svg>
</a>

<style>
  /* Like a tile's frame, shrunk: the makers' cut-outs sit whole on white, our own photos fill and crop. */
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2px;
    box-sizing: border-box;
  }

  .thumb img.fill {
    object-fit: cover;
    padding: 0;
  }

  .blank {
    width: 60%;
    fill: none;
    stroke: #b9b5ab;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .thumb:has(img) .blank {
    display: none;
  }

  .thumb:not(:has(img)) {
    background: color-mix(in srgb, var(--text) 5%, var(--surface));
  }
</style>
