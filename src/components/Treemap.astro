---
import { metrics } from '../lib/metrics';
import { layoutTreemap, renderCells, renderLegend, renderNote, renderUnsized, type ChartData, type Options } from '../lib/treemap';

interface Props {
  // A name for the chart's state in the browser, so each page remembers its own choices.
  id: string;
  data: ChartData;
  // What is grouped and sized, for screen readers: "Brands", "Ownership groups".
  title: string;
  initial?: Partial<Options>;
  // The id of a filtered table whose rows carry `data-id`, which the chart follows.
  follow?: string;
}

const { id, data, title, initial = {}, follow } = Astro.props;
// How many brands have a figure for each measure, so a measure with none can be offered as "no data yet".
// Only brands the chart can place count, so a page showing groups alone does not count independents.
const placeable = data.points.filter((point) =>
  data.groupings.some((grouping) => grouping.buckets.some((bucket) => point.buckets[grouping.id]?.includes(bucket.key) || point.licensee === bucket.key)),
);
const coverage = Object.fromEntries(metrics.map((metric) => [metric.id, placeable.filter((point) => point.values[metric.id] !== undefined).length]));
// Measures that add up can size the whole chart; the rest size brands only within one box.
const totals = metrics.filter((metric) => metric.additive);
const perBrand = metrics.filter((metric) => !metric.additive);
const colors = metrics.filter((metric) => !metric.additive);
// Measures with a group-level figure, for which a group's other business can be shown.
const withOwn = metrics.filter((metric) => data.groupings.some((grouping) => grouping.buckets.some((bucket) => bucket.values?.[metric.id] !== undefined)));
const options: Options = { grouping: data.groupings[0].id, size: 'brands', color: 'age', otherBusiness: true, ...initial };
const layout = layoutTreemap(data, options);
const optionLabel = (id: string) => (coverage[id] === 0 ? ' (no data yet)' : ` (${coverage[id]})`);
---

<section class="treemap" data-treemap={id} data-follow={follow} aria-label={`${title} treemap`}>
  <div class="controls">
    <label class="control" hidden={data.groupings.length < 2}>
      <span>Group by</span>
      <select name="grouping">
        {data.groupings.map((grouping) => <option value={grouping.id} selected={grouping.id === options.grouping}>{grouping.label}</option>)}
      </select>
    </label>
    <label class="control">
      <span>Size by</span>
      <select name="size">
        <optgroup label="Totals for each box">
          {
            totals.map((metric) => (
              <option
                value={metric.id}
                selected={metric.id === layout.size.id}
                disabled={coverage[metric.id] === 0 || (layout.mode === 'zoomed' && metric.uniform)}
                data-uniform={metric.uniform ? '' : undefined}
                data-has-data={coverage[metric.id] > 0 ? '' : undefined}
              >
                {metric.label}
                {metric.uniform ? '' : optionLabel(metric.id)}
              </option>
            ))
          }
        </optgroup>
        <optgroup label="Within one box">
          {
            perBrand.map((metric) => (
              <option
                value={metric.id}
                selected={metric.id === layout.size.id}
                disabled={coverage[metric.id] === 0 || layout.mode !== 'zoomed'}
                data-per-brand
                data-has-data={coverage[metric.id] > 0 ? '' : undefined}
              >
                {metric.label}
                {optionLabel(metric.id)}
              </option>
            ))
          }
        </optgroup>
      </select>
    </label>
    <label class="control">
      <span>Shade by</span>
      <select name="color">
        <option value="" selected={!options.color}>Nothing</option>
        {
          colors.map((metric) => (
            <option value={metric.id} selected={metric.id === options.color} disabled={coverage[metric.id] === 0}>
              {metric.label}
              {optionLabel(metric.id)}
            </option>
          ))
        }
      </select>
    </label>
    <label class="toggle" data-own={withOwn.map((metric) => metric.id).join(' ')} hidden={!withOwn.some((metric) => metric.id === options.size)}>
      <input type="checkbox" name="otherBusiness" checked={options.otherBusiness} />
      Include groups’ other business
    </label>
  </div>

  <nav class="crumbs" aria-label="Zoom" hidden={!layout.zoomed}>
    <button type="button" data-unzoom>← All by {layout.grouping.label.toLowerCase()}</button>
    <strong class="crumb-current">{layout.zoomed?.name}</strong>
    <a class="crumb-page" href={layout.zoomed?.href} hidden={!layout.zoomed?.href}>Open its page</a>
  </nav>

  <div class="frame">
    <div class="scroll">
      <div class="canvas" aria-label={`${title}, grouped and sized`} set:html={renderCells(layout)} />
    </div>
    <div class="tip" role="presentation" hidden></div>
  </div>
  <p class="legend" set:html={renderLegend(layout)} />
  <p class="note" aria-live="polite" set:html={renderNote(layout)} />
  <div class="unsized" set:html={renderUnsized(layout)} />
  <script is:inline type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</section>

<style>
  .treemap {
    margin-bottom: 32px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 16px;
    margin-bottom: 12px;
  }

  .control span {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .control[hidden],
  .toggle[hidden] {
    display: none;
  }

  select {
    max-width: 100%;
    padding: 4px 8px;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 4px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin-bottom: 8px;
    font-size: 0.9375rem;
  }

  .crumbs[hidden] {
    display: none;
  }

  .crumbs button {
    padding: 2px 8px;
    font: inherit;
    font-size: 0.875rem;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }

  .crumb-page {
    font-size: 0.875rem;
  }

  .unsized :global(details) {
    margin-top: 8px;
    font-size: 0.8125rem;
  }

  .unsized :global(summary) {
    color: var(--muted);
    cursor: pointer;
  }

  .unsized :global(ul) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .unsized :global(li a) {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
  }

  .frame {
    position: relative;
  }

  /* Below this width the cells get too small to read, so the map scrolls sideways instead. */
  .scroll {
    overflow-x: auto;
  }

  .canvas {
    position: relative;
    min-width: 640px;
    aspect-ratio: 1000 / 600;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .canvas :global(.bucket),
  .canvas :global(.other),
  .canvas :global(.brand) {
    position: absolute;
    box-sizing: border-box;
  }

  .canvas :global(.bucket) {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  /* A bucket's name zooms into it. */
  .canvas :global(.bucket-name) {
    display: block;
    max-width: 100%;
    overflow: hidden;
    padding: 2px 6px 0;
    font: inherit;
    font-size: 0.75rem;
    color: var(--accent);
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 2px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* A whole bucket, shaded by its median and zooming into its brands. */
  .canvas :global(.tile) {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    overflow: hidden;
    padding: 6px 8px;
    font: inherit;
    color: #1c1b19;
    text-align: left;
    cursor: pointer;
    background: var(--shade, var(--bg));
    border: 1px solid color-mix(in srgb, #1c1b19 14%, transparent);
    border-radius: 4px;
  }

  .canvas :global(.tile.tight) {
    padding: 0;
  }

  .canvas :global(.tile.on-dark) {
    color: #ffffff;
  }

  /* Without a shade measure, tiles take the page's own colors. */
  .canvas :global(.tile:not([style*='--shade'])) {
    color: var(--text);
    border-color: var(--line);
  }

  .canvas :global(.tile.unshaded) {
    background: repeating-linear-gradient(135deg, var(--bg) 0 5px, var(--line) 5px 6px);
  }

  .canvas :global(.tile:hover),
  .canvas :global(.tile:focus-visible) {
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* Nothing in a tile shrinks: what does not fit is cut off at the bottom, logos first. */
  .canvas :global(.tile > *) {
    flex: none;
  }

  /* The tile's name, after a badge counting its brands. */
  .canvas :global(.tile-head) {
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
  }

  .canvas :global(.tile-badge) {
    flex: none;
    min-width: 1.5em;
    padding: 1px 5px;
    box-sizing: border-box;
    font-size: 0.6875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    text-align: center;
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 999px;
  }

  .canvas :global(.tile-name) {
    min-width: 0;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .canvas :global(.tile-logos) {
    display: grid;
    gap: 4px;
    width: 100%;
    margin-top: 6px;
  }

  /* Logos are drawn for a light page, so each sits on a white plate. */
  .canvas :global(.tile .plate) {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 100%;
    padding: 6% 8%;
    background: #ffffff;
    border-radius: 2px;
  }

  .canvas :global(.tile .plate.named) {
    overflow: hidden;
    padding: 0 4px;
    color: #1c1b19;
  }

  /* A name set at the size that fits its space, on one line or two (see fitName in src/lib/treemap.ts). One that
     cannot fit even at the smallest size is cut short. */
  .canvas :global(.fit) {
    display: block;
    max-width: 100%;
    overflow: hidden;
    line-height: 1.15;
    text-align: center;
    white-space: nowrap;
  }

  .canvas :global(.fit.cut) {
    text-overflow: ellipsis;
  }

  .canvas :global(.tile .plate.more) {
    color: inherit;
    font-size: var(--plate-font, 0.625rem);
    font-weight: 600;
    white-space: nowrap;
    background: transparent;
    border: 1px dashed currentColor;
  }

  .canvas :global(.tile .plate img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .canvas :global(.brand) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2px;
    color: #1c1b19;
    font-size: 0.6875rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    /* Logos are drawn for a light page, so cells stay white in both color schemes. */
    background: #ffffff;
    border: 1px solid #d4d0c6;
    border-radius: 2px;
  }

  /* A brand shaded by a measure is filled with its step. */
  .canvas :global(.brand.shaded) {
    background: var(--shade, #ffffff);
    border-color: color-mix(in srgb, #1c1b19 18%, transparent);
  }

  /* No figure for the shading measure: a faint hatch, so it never reads as the lightest step. */
  .canvas :global(.brand.unshaded) {
    background: repeating-linear-gradient(135deg, #ffffff 0 3px, #e2dfd7 3px 4px);
  }

  /* On a shade, each logo is set by its own contrast with it (see src/lib/logo-contrast.ts): plain (as is a badge), with a thin
     white halo along its edges that lifts a dark mark, or with a thin dark halo for a mid-toned mark a white one cannot rescue. */
  .canvas :global(.brand img[data-set='halo']) {
    filter: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.85)) drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5));
  }

  .canvas :global(.brand img[data-set='dark-halo']) {
    filter: drop-shadow(0 0 0.5px rgb(28 27 25 / 0.9)) drop-shadow(0 0 1px rgb(28 27 25 / 0.6));
  }

  .canvas :global(.brand.on-dark) {
    color: #ffffff;
  }

  /* Made under license by the group, not owned by it. */
  .canvas :global(.brand.licensed) {
    border-style: dashed;
    border-color: #6b6860;
  }

  .canvas :global(.brand:hover),
  .canvas :global(.brand:focus-visible) {
    z-index: 1;
    outline: 2px solid var(--accent);
  }

  .canvas :global(.brand .fit.vertical) {
    max-width: none;
    max-height: 100%;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  .canvas :global(.brand img) {
    max-width: 80%;
    max-height: 60%;
    object-fit: contain;
  }

  .canvas :global(.other) {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.6875rem;
    background: repeating-linear-gradient(135deg, transparent 0 6px, var(--line) 6px 7px);
    border: 1px dashed var(--line);
    border-radius: 2px;
  }

  .tip {
    position: absolute;
    z-index: 2;
    max-width: 260px;
    padding: 6px 9px;
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: pre-line;
    pointer-events: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .tip::first-line {
    font-weight: 600;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .legend:empty {
    display: none;
  }

  .legend :global(.legend-label) {
    margin-right: 4px;
    color: var(--text);
  }

  .legend :global(.swatches) {
    display: inline-flex;
    gap: 2px;
  }

  .legend :global(.swatch) {
    display: inline-block;
    width: 22px;
    height: 10px;
    border-radius: 2px;
  }

  .legend :global(.swatch.none) {
    margin-left: 12px;
    background: repeating-linear-gradient(135deg, #ffffff 0 3px, #c9c5bb 3px 4px);
    border: 1px solid var(--line);
  }

  .note {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>

<script>
  import { setLogos } from '../lib/logo-contrast';
  import { layoutTreemap, renderCells, renderLegend, renderNote, renderUnsized, zoomedBucket, type ChartData, type Options } from '../lib/treemap';

  // Choices are remembered per page in this browser. Storage can be missing or blocked, in which case the page keeps its defaults.
  const recall = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const remember = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {
      // Not remembered this time.
    }
  };

  for (const section of document.querySelectorAll<HTMLElement>('[data-treemap]')) {
    const data: ChartData = JSON.parse(section.querySelector('script[type="application/json"]')!.textContent!);
    const canvas = section.querySelector<HTMLElement>('.canvas')!;
    const legend = section.querySelector<HTMLElement>('.legend')!;
    const note = section.querySelector<HTMLElement>('.note')!;
    const tip = section.querySelector<HTMLElement>('.tip')!;
    const frame = section.querySelector<HTMLElement>('.frame')!;
    const selects = {
      grouping: section.querySelector<HTMLSelectElement>('select[name="grouping"]')!,
      size: section.querySelector<HTMLSelectElement>('select[name="size"]')!,
      color: section.querySelector<HTMLSelectElement>('select[name="color"]')!,
    };
    const other = section.querySelector<HTMLInputElement>('input[name="otherBusiness"]')!;
    const toggle = other.closest<HTMLElement>('.toggle')!;
    const ownMeasures = toggle.dataset.own!.split(' ');
    const key = (name: string) => `treemap.${section.dataset.treemap}.${name}`;

    const unsized = section.querySelector<HTMLElement>('.unsized')!;
    const crumbs = section.querySelector<HTMLElement>('.crumbs')!;
    const unzoomButton = crumbs.querySelector<HTMLButtonElement>('[data-unzoom]')!;
    const crumbCurrent = crumbs.querySelector<HTMLElement>('.crumb-current')!;
    const crumbPage = crumbs.querySelector<HTMLAnchorElement>('.crumb-page')!;

    for (const name of ['grouping', 'color'] as const) {
      const saved = recall(key(name));
      const select = selects[name];
      if (saved !== null && [...select.options].some((option) => option.value === saved && !option.disabled)) select.value = saved;
    }
    const savedOther = recall(key('otherBusiness'));
    if (savedOther !== null) other.checked = savedOther === 'true';
    // The overview and a zoomed box each keep their own size measure, since they offer different ones.
    const sizeChoice = { overview: recall(key('size')) ?? selects.size.value, zoomed: recall(key('zoomSize')) ?? 'age' };
    // The box zoomed into. A fresh visit starts on the overview.
    let zoom: string | undefined;

    // The rows the page's filters leave showing, when the chart follows a table.
    const followed = section.dataset.follow;
    const visibleRows = () => {
      if (!followed) return undefined;
      const rows = [...document.querySelectorAll<HTMLElement>(`#${followed} tr[data-id]`)];
      return { ids: new Set(rows.filter((row) => !row.hidden).map((row) => row.dataset.id!)), all: rows.length };
    };
    const zoomedNow = () => {
      const grouping = data.groupings.find((candidate) => candidate.id === selects.grouping.value) ?? data.groupings[0];
      return Boolean(zoomedBucket(grouping, zoom));
    };

    const draw = () => {
      const zoomed = zoomedNow();
      // Offer the measures that suit this view: totals in the overview, anything that differs by brand within a box.
      for (const option of selects.size.options) {
        const suits = zoomed ? !('uniform' in option.dataset) : !('perBrand' in option.dataset);
        option.disabled = !suits || !('hasData' in option.dataset);
      }
      const rows = visibleRows();
      const options: Options = {
        grouping: selects.grouping.value,
        size: zoomed ? sizeChoice.zoomed : sizeChoice.overview,
        color: selects.color.value || undefined,
        otherBusiness: other.checked,
        visible: rows && rows.ids.size < rows.all ? rows.ids : undefined,
        zoom,
      };
      const layout = layoutTreemap(data, options);
      selects.size.value = layout.size.id;
      toggle.hidden = layout.mode === 'buckets' || !ownMeasures.includes(layout.size.id);
      canvas.innerHTML = renderCells(layout, canvas.clientWidth / 1000);
      setLogos(canvas);
      legend.innerHTML = renderLegend(layout);
      note.innerHTML = renderNote(layout, options.visible !== undefined);
      unsized.innerHTML = renderUnsized(layout);
      crumbs.hidden = !layout.zoomed;
      if (layout.zoomed) {
        unzoomButton.textContent = `← All by ${layout.grouping.label.toLowerCase()}`;
        crumbCurrent.textContent = layout.zoomed.name;
        crumbPage.hidden = !layout.zoomed.href;
        if (layout.zoomed.href) crumbPage.href = layout.zoomed.href;
      }
      // Kept on the element as well, for a listener that starts after the first draw. A zoomed view
      // shows one box, so it leaves the overview's totals in place.
      if (layout.mode !== 'zoomed') {
        section.dataset.size = layout.size.id;
        section.dataset.totals = JSON.stringify(layout.totals);
        section.dispatchEvent(new CustomEvent('treemap:layout', { bubbles: true }));
      }
    };

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const zoomTo = (next: string | undefined) => {
      const previous = zoom;
      zoom = next;
      draw();
      if (!still.matches) canvas.animate([{ opacity: 0, scale: next ? '0.96' : '1.03' }, { opacity: 1, scale: '1' }], { duration: 220, easing: 'ease-out' });
      // Keyboard focus follows: to the way back out, or to the box just left.
      if (next) unzoomButton.focus();
      else if (previous) canvas.querySelector<HTMLElement>(`[data-zoom="${CSS.escape(previous)}"]`)?.focus();
    };

    selects.grouping.addEventListener('change', () => {
      remember(key('grouping'), selects.grouping.value);
      zoom = undefined;
      draw();
    });
    selects.color.addEventListener('change', () => {
      remember(key('color'), selects.color.value);
      draw();
    });
    selects.size.addEventListener('change', () => {
      const zoomed = zoomedNow();
      sizeChoice[zoomed ? 'zoomed' : 'overview'] = selects.size.value;
      remember(key(zoomed ? 'zoomSize' : 'size'), selects.size.value);
      draw();
    });
    other.addEventListener('change', () => {
      remember(key('otherBusiness'), String(other.checked));
      draw();
    });
    canvas.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-zoom]');
      if (!target) return;
      tip.hidden = true;
      zoomTo(target.dataset.zoom);
    });
    unzoomButton.addEventListener('click', () => zoomTo(undefined));
    section.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && zoom !== undefined) zoomTo(undefined);
    });
    // Typing in the search box filters on every keystroke; the chart redraws at most once a frame.
    let pending = 0;
    const redraw = () => {
      cancelAnimationFrame(pending);
      pending = requestAnimationFrame(draw);
    };
    if (followed) document.addEventListener('filters:applied', (event) => (event as CustomEvent).detail?.target === followed && redraw());
    // How many brands fit in a tile depends on the drawn width, so a wider or narrower window redraws.
    let width = canvas.clientWidth;
    new ResizeObserver(() => {
      if (canvas.clientWidth === width) return;
      width = canvas.clientWidth;
      redraw();
    }).observe(canvas);

    // One tooltip for the whole chart, placed beside the pointer or the focused cell and kept inside the frame.
    const place = (x: number, y: number) => {
      const bounds = frame.getBoundingClientRect();
      const left = Math.min(x - bounds.left + 14, bounds.width - tip.offsetWidth - 4);
      const top = y - bounds.top + 14 + tip.offsetHeight > bounds.height ? y - bounds.top - tip.offsetHeight - 10 : y - bounds.top + 14;
      tip.style.left = `${Math.max(4, left)}px`;
      tip.style.top = `${top}px`;
    };
    const show = (target: HTMLElement) => {
      tip.textContent = target.dataset.tip!;
      tip.hidden = false;
    };
    canvas.addEventListener('pointermove', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-tip]');
      if (!target) return void (tip.hidden = true);
      show(target);
      place(event.clientX, event.clientY);
    });
    canvas.addEventListener('pointerleave', () => (tip.hidden = true));
    canvas.addEventListener('focusin', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-tip]');
      if (!target) return;
      show(target);
      const rect = target.getBoundingClientRect();
      place(rect.left + rect.width / 2, rect.bottom - 10);
    });
    canvas.addEventListener('focusout', () => (tip.hidden = true));

    draw();
  }
</script>
