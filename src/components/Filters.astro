---
// A search box and a row of dropdowns that filter the rows of one table.
// Each row carries `data-q` (lowercase search text) and one `data-<name>` per filter, holding one value or
// several joined with "|".
interface Filter {
  name: string;
  label: string;
  options: { value: string; label: string }[];
}

interface Props {
  // The id of the <tbody> whose rows are filtered.
  target: string;
  // What a row is, plural, for the count: "brands", "references".
  noun: string;
  placeholder: string;
  filters: Filter[];
}

const { target, noun, placeholder, filters } = Astro.props;
---

<form class="filters" data-filters data-target={target} data-noun={noun}>
  <label class="search">
    <span class="visually-hidden">{placeholder}</span>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5"></circle>
      <path d="m13 13 4.5 4.5"></path>
    </svg>
    <input type="search" name="q" placeholder={placeholder} autocomplete="off" />
  </label>

  <div class="fields">
    {
      filters.map((filter) => (
        <label class="field">
          <span>{filter.label}</span>
          <select name={filter.name}>
            <option value="">All</option>
            {filter.options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
      ))
    }
  </div>

  <div class="summary">
    <span data-count aria-live="polite"></span>
    <button type="reset" data-clear hidden>Clear filters</button>
  </div>
</form>

<p class="empty" data-empty-for={target} hidden>Nothing matches these filters.</p>

<style>
  .filters {
    display: grid;
    gap: 12px;
    margin-bottom: 16px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .search {
    position: relative;
    display: block;
  }

  .search svg {
    position: absolute;
    top: 50%;
    left: 12px;
    width: 16px;
    height: 16px;
    translate: 0 -50%;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.75;
    stroke-linecap: round;
    pointer-events: none;
  }

  input,
  select {
    width: 100%;
    height: 40px;
    font: inherit;
    color: var(--text);
    background-color: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  input {
    padding: 0 12px 0 36px;
  }

  select {
    padding: 0 32px 0 12px;
    text-transform: capitalize;
    text-overflow: ellipsis;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--muted) 50%),
      linear-gradient(135deg, var(--muted) 50%, transparent 50%);
    background-position:
      calc(100% - 17px) 17px,
      calc(100% - 12px) 17px;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  /* A filter that is narrowing the list stands out from the ones left on "All". */
  select.active {
    border-color: var(--accent);
  }

  /* The focus ring is a neutral color so it cannot be mistaken for the accent border of a filter in use. */
  input:focus-visible,
  select:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--muted);
    outline-offset: 1px;
  }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }

  .field span {
    display: block;
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 24px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  button {
    padding: 0;
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .empty {
    margin: 0 0 16px;
    color: var(--muted);
  }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-filters]')) {
    const target = form.dataset.target!;
    const rows = [...document.querySelectorAll<HTMLTableRowElement>(`#${target} tr`)];
    const selects = [...form.querySelectorAll('select')];
    const search = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const count = form.querySelector('[data-count]')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-clear]')!;
    const empty = document.querySelector<HTMLElement>(`[data-empty-for="${target}"]`)!;

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      const wanted = selects.filter((select) => select.value);
      for (const select of selects) select.classList.toggle('active', select.value !== '');

      let shown = 0;
      for (const row of rows) {
        const match =
          row.dataset.q!.includes(q) &&
          wanted.every((select) => (row.dataset[select.name] ?? '').split('|').includes(select.value));
        row.hidden = !match;
        if (match) shown++;
      }

      const filtering = q !== '' || wanted.length > 0;
      count.textContent = filtering
        ? `${shown} of ${rows.length} ${form.dataset.noun}`
        : `${rows.length} ${form.dataset.noun}`;
      clear.hidden = !filtering;
      empty.hidden = shown > 0;
    };

    // A dropdown keeps focus after a mouse pick, and its focus ring then looks like a filter still in use.
    // Drop focus after a pointer pick; keyboard users keep it so they can carry on.
    let byPointer = false;
    for (const select of selects) {
      select.addEventListener('pointerdown', () => (byPointer = true));
      select.addEventListener('keydown', () => (byPointer = false));
      select.addEventListener('change', () => byPointer && select.blur());
    }

    form.addEventListener('input', apply);
    form.addEventListener('submit', (event) => event.preventDefault());
    // The reset event fires before the fields clear, so wait a tick.
    form.addEventListener('reset', () => setTimeout(apply));
    apply();
  }
</script>
