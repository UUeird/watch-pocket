---
import { currentOwnerIds, loadCatalog, type Brand } from '../lib/catalog';

interface Props {
  brand: Brand;
}

const { groupsById } = await loadCatalog();
const owners = currentOwnerIds(Astro.props.brand);
---

{
  owners.map((id, index) => (
    <>
      {index > 0 && ', '}
      <a href={`/ownership-groups/${id}/`}>{groupsById.get(id)?.data.name}</a>
    </>
  ))
}
