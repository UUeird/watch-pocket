---
import { currentOwners, loadCatalog, ownerHref, type Brand } from '../lib/catalog';

interface Props {
  brand: Brand;
}

const { ownerName } = await loadCatalog();
const owners = currentOwners(Astro.props.brand);
---

{Astro.props.brand.data.independent && 'Independent'}
{
  owners.map((owner, index) => (
    <>
      {index > 0 && ', '}
      <a href={ownerHref(owner)}>{ownerName(owner)}</a>
    </>
  ))
}
