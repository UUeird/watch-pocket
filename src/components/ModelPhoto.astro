---
// Photos of a model or of one of its references, and a link to the maker's page for the model. The photos are the best
// we may show:
// 1. our own copies, from Wikimedia Commons under a free license or from the brand's press kit, each credited. The
//    first is the primary, shown large; the rest sit under it as thumbnails that swap in when picked. A model shows
//    its own, then its references' (each labeled with its reference); a reference shows its own, or failing that the
//    model's, saying so. A reference's own product shot from its maker (`officialPhoto`) leads its gallery, ahead of
//    our copies, so it looks like the references around it;
// 2. otherwise the brand's own image from its page (see scripts/refresh-official-photos.mjs), loaded from their site
//    and credited to them. If it fails to load, the figure removes itself and the link stands alone.
import { Image, getImage } from 'astro:assets';
import officialPhotos from '../data/official-photos.json';
import { sourceHost, type Model, type Reference } from '../lib/catalog';

interface Props {
  model: Model;
  brandName: string;
  // Set on a reference's page.
  reference?: Reference;
}

const { model, brandName, reference } = Astro.props;
const { name } = model.data;
// On a reference's page, the maker's page for that reference, or else the model's page unless that is another
// reference's own.
const modelPage = model.data.website;
const website = reference ? (reference.website ?? (model.data.references.some((other) => other.website === modelPage) ? undefined : modelPage)) : modelPage;
const ofModel = model.data.photos.map((photo) => ({ ...photo, ref: undefined as string | undefined }));
const ofReferences = model.data.references.flatMap(({ ref, photos }) => photos.map((photo) => ({ ...photo, ref })));
const own = reference ? reference.photos.map((photo) => ({ ...photo, ref: undefined })) : [];
// The maker's image of this reference, which leads: before our copies of it, and before any photo of the model.
const refOfficial = reference?.officialPhoto;
const photos = reference ? (own.length > 0 || refOfficial ? own : ofModel) : [...ofModel, ...ofReferences];
// On a reference's page, photos of the model in general rather than of this reference.
const general = reference !== undefined && own.length === 0 && !refOfficial && photos.length > 0;
const official = refOfficial ?? (photos.length > 0 ? undefined : (officialPhotos as Record<string, { src: string; page: string }>)[model.id]);
// Where the maker's image leads a gallery of our copies, it is its first photo and has a thumbnail of its own; the
// figures and thumbnails of our copies are numbered after it.
const leads = official !== undefined && photos.length > 0;
const offset = leads ? 1 : 0;
const count = photos.length + offset;
const alt = `${brandName} ${name}${reference ? ` ${reference.ref}` : ''}`;
const altOf = (ref: string | undefined) => (ref ? `${brandName} ${name} ${ref}` : alt);
// A magnifier with a plus, the usual sign that a photo can be enlarged.
const zoomIcon =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg>';
// A larger copy of each photo for the enlarged view, no wider than the original.
const enlarged = await Promise.all(photos.map(({ file }) => getImage({ src: file, width: Math.min(file.width, 1600) })));
---

{
  (photos.length > 0 || official || website) && (
    <aside class="model-photo" data-gallery>
      {official && (
        <figure data-official-photo data-photo={leads ? 0 : undefined}>
          <button type="button" class="zoom" data-zoom={official.src} data-alt={alt} aria-label={`Enlarge photo: ${alt}`}>
            <img src={official.src} alt={leads ? `${alt}, photo 1 of ${count}` : alt} loading={leads ? undefined : 'lazy'} referrerpolicy="no-referrer" onerror="const figure = this.closest('figure'); figure.dataset.failed = ''; figure.dispatchEvent(new Event('photo-failed', { bubbles: true }))" />
            <span class="zoom-icon" aria-hidden="true"><Fragment set:html={zoomIcon} /></span>
          </button>
          <figcaption>
            Image © {brandName}, shown from <a href={official.page}>{sourceHost(official.page)}</a>
          </figcaption>
        </figure>
      )}
      {photos.map(({ file, credit, ref }, index) => (
        <figure data-photo={index + offset} hidden={index + offset > 0}>
          <button type="button" class="zoom" data-zoom={enlarged[index].src} data-alt={altOf(ref)} aria-label={`Enlarge photo: ${altOf(ref)}`}>
            <Image src={file} alt={count > 1 ? `${altOf(ref)}, photo ${index + offset + 1} of ${count}` : altOf(ref)} widths={[360, 720]} sizes="(min-width: 720px) 360px, 100vw" />
            <span class="zoom-icon" aria-hidden="true"><Fragment set:html={zoomIcon} /></span>
          </button>
          <figcaption>
            {ref && <span class="ref">{ref} · </span>}
            Photo{credit.author && ` by ${credit.author}`} · {credit.licenseUrl ? <a href={credit.licenseUrl}>{credit.license}</a> : credit.license} ·{' '}
            <a href={credit.source}>Source</a>
          </figcaption>
        </figure>
      ))}
      {general && <p class="general">Shows the {name} in general, not this reference in particular.</p>}
      {count > 1 && (
        <div class="thumbs" role="group" aria-label="Photos">
          {leads && (
            <button type="button" data-show="0" data-official-thumb aria-pressed="true" aria-label="Show photo 1">
              <img src={official.src} alt="" width="96" referrerpolicy="no-referrer" />
            </button>
          )}
          {photos.map(({ file }, index) => (
            <button type="button" data-show={index + offset} aria-pressed={index + offset === 0 ? 'true' : 'false'} aria-label={`Show photo ${index + offset + 1}`}>
              <Image src={file} alt="" width={96} />
            </button>
          ))}
        </div>
      )}
      {
        website && (
          <a class="official" href={website} target="_blank" rel="noopener">
            See it on {sourceHost(website)} <span aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        )
      }
      <dialog class="lightbox" data-lightbox aria-label="Enlarged photo">
        <img alt="" referrerpolicy="no-referrer" />
        <p class="caption" data-caption aria-live="polite"></p>
        {count > 1 && (
          <>
            <button type="button" class="nav prev" data-step="-1" aria-label="Previous photo">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" class="nav next" data-step="1" aria-label="Next photo">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </>
        )}
        <button type="button" class="close" data-close aria-label="Close">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </dialog>
    </aside>
  )
}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    // Picking a thumbnail shows that photo, with its credit, in place of the one shown.
    let buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-show]')];
    let figures = [...gallery.querySelectorAll<HTMLElement>('[data-photo]')];
    const select = (index: number) => {
      for (const figure of figures) figure.hidden = figure.dataset.photo !== String(index);
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.show === String(index)));
    };
    for (const button of buttons) button.addEventListener('click', () => select(Number(button.dataset.show)));

    // Picking a photo opens a larger copy over the page, with its credit. Where there are several, the arrows (or the
    // arrow keys) step through them, and the page is left showing the last one seen. Escape, the close button or a
    // click outside the photo closes it.
    const lightbox = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const large = lightbox?.querySelector('img');
    const caption = lightbox?.querySelector<HTMLElement>('[data-caption]');
    if (!lightbox || !large || !caption) continue;
    let zooms = [...gallery.querySelectorAll<HTMLButtonElement>('[data-zoom]')];
    let current = 0;
    // If the maker's image fails to load, it goes, with its thumbnail; where it led our copies, the next one shows.
    // One that failed before this script ran is marked, and dropped here.
    const drop = (figure: HTMLElement) => {
      const led = figure.dataset.photo === '0';
      figure.remove();
      gallery.querySelector('[data-official-thumb]')?.remove();
      buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-show]')];
      figures = [...gallery.querySelectorAll<HTMLElement>('[data-photo]')];
      zooms = [...gallery.querySelectorAll<HTMLButtonElement>('[data-zoom]')];
      if (led && figures[0]) select(Number(figures[0].dataset.photo));
      if (buttons.length < 2) gallery.querySelector('.thumbs')?.remove();
    };
    gallery.addEventListener('photo-failed', (event) => drop(event.target as HTMLElement));
    for (const figure of gallery.querySelectorAll<HTMLElement>('figure[data-failed]')) drop(figure);
    const show = (index: number) => {
      current = (index + zooms.length) % zooms.length;
      const zoom = zooms[current];
      large.src = zoom.dataset.zoom ?? '';
      large.alt = zoom.dataset.alt ?? '';
      const credit = zoom.closest('figure')?.querySelector('figcaption')?.innerHTML ?? '';
      caption.innerHTML = zooms.length > 1 ? `<span class="count">${current + 1} of ${zooms.length}</span> · ${credit}` : credit;
      const shown = zoom.closest<HTMLElement>('figure')?.dataset.photo;
      if (shown !== undefined) select(Number(shown));
    };
    zooms.forEach((zoom) =>
      zoom.addEventListener('click', () => {
        show(zooms.indexOf(zoom));
        lightbox.showModal();
      }),
    );
    for (const step of lightbox.querySelectorAll<HTMLButtonElement>('[data-step]')) {
      step.addEventListener('click', () => show(current + Number(step.dataset.step)));
    }
    lightbox.addEventListener('keydown', (event) => {
      if (zooms.length < 2) return;
      if (event.key === 'ArrowRight') show(current + 1);
      else if (event.key === 'ArrowLeft') show(current - 1);
      else return;
      event.preventDefault();
    });
    lightbox.querySelector('[data-close]')?.addEventListener('click', () => lightbox.close());
    // A click on the dialog itself, not on anything in it, landed on the backdrop.
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('close', () => large.removeAttribute('src'));
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .model-photo {
    display: grid;
    gap: 10px;
    justify-items: start;
    width: min(360px, 100%);
  }

  figure {
    margin: 0;
    width: 100%;
  }

  /* Product shots are made for a light page, so each sits on a white plate in both color schemes. */
  /* Sized to the photo's own shape, so a tall photo gets a narrower frame rather than white bars beside it. */
  figure img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 420px;
    object-fit: contain;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  /* Shrinks to the photo, so the magnifier sits on the photo's own corner. */
  .zoom {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: zoom-in;
  }

  .zoom:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .zoom-icon {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 999px;
    opacity: 0.8;
    transition: opacity 120ms;
  }

  .zoom:hover .zoom-icon,
  .zoom:focus-visible .zoom-icon {
    opacity: 1;
  }

  .lightbox {
    max-width: min(95vw, 1200px);
    max-height: 95vh;
    padding: 0;
    overflow: visible;
    background: #ffffff;
    border: 0;
    border-radius: 8px;
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
    cursor: zoom-out;
  }

  .lightbox img {
    display: block;
    max-width: min(95vw, 1200px);
    max-height: calc(95vh - 3.5rem);
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    border-radius: 8px 8px 0 0;
  }

  /* The credit sits on a dark strip under the photo, so its fixed colors read the same in both color schemes. */
  .caption {
    margin: 0;
    padding: 8px 12px;
    font-size: 0.8125rem;
    color: #e6e6e6;
    background: #1f1f1f;
    border-radius: 0 0 8px 8px;
  }

  .caption :global(a) {
    color: #ffffff;
  }

  .caption :global(.ref),
  .caption :global(.count) {
    color: #ffffff;
    font-weight: 500;
  }

  .nav,
  .close {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.65);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }

  .nav {
    top: calc(50% - 1.75rem);
    transform: translateY(-50%);
  }

  .prev {
    left: 8px;
  }

  .next {
    right: 8px;
  }

  .close {
    top: 8px;
    right: 8px;
  }

  .nav:hover,
  .close:hover {
    background: rgba(0, 0, 0, 0.85);
  }

  .nav:focus-visible,
  .close:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  figcaption {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .ref {
    color: var(--ink);
    font-weight: 500;
  }

  .general {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .thumbs button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 2px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }

  .thumbs button[aria-pressed='true'] {
    border: 2px solid var(--accent);
  }

  .thumbs img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .official {
    padding: 6px 12px;
    font-size: 0.875rem;
    text-decoration: none;
    border: 1px solid var(--accent);
    border-radius: 999px;
  }

  .official:hover,
  .official:focus-visible {
    text-decoration: underline;
  }
</style>
