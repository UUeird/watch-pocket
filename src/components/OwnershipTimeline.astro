---
import { href, plural, type Brand, type Group } from '../lib/catalog';

interface Props {
  // Each group with every ownership record naming it, current and past.
  holdings: { group: Group; records: { brand: Brand; from?: number; to?: number }[] }[];
}

const { holdings } = Astro.props;
const thisYear = new Date().getFullYear();
// Almost every dated purchase is from 1980 on; earlier ones share a column at the left rather than stretch the axis.
const start = 1980;
const span = thisYear - start;
const at = (year: number) => `${(((Math.max(year, start) - start) / span) * 100).toFixed(2)}%`;
const ticks = Array.from({ length: Math.floor(span / 10) + 1 }, (_, index) => start + index * 10);

type Mark = { brand: Brand; from: number; to?: number; row: number };
const lanes = holdings
  .map(({ group, records }) => {
    const dated = records.filter((record) => record.from !== undefined).sort((a, b) => a.from! - b.from!);
    const undated = records.filter((record) => record.from === undefined && record.to === undefined).length;
    // Each mark takes the first row where it overlaps nothing, so no dot or line hides another.
    // A dot is about a year and a half wide on the axis; earlier purchases all sit at one spot.
    const taken: [number, number][][] = [];
    const marks: Mark[] = dated.map(({ brand, from, to }) => {
      const left = Math.max(from!, start - 2);
      const right = Math.max(to ?? from!, start - 2) + 1.5;
      let row = taken.findIndex((spans) => spans.every(([a, b]) => right <= a || left >= b));
      if (row === -1) row = taken.push([]) - 1;
      taken[row].push([left, right]);
      return { brand, from: from!, to, row };
    });
    const rows = Math.max(1, ...marks.map((mark) => mark.row + 1));
    return { group, marks, undated, rows };
  })
  .filter((lane) => lane.marks.length > 0)
  .sort((a, b) => b.marks.length - a.marks.length || a.marks[0].from - b.marks[0].from);
const undatedTotal = holdings.reduce((total, { records }) => total + records.filter((record) => record.from === undefined && record.to === undefined).length, 0);
const datedTotal = lanes.reduce((total, lane) => total + lane.marks.length, 0);

const describe = ({ brand, from, to }: Mark, group: Group) =>
  [brand.data.name, group.data.name, to === undefined ? `Held since ${from}` : `Held ${from}–${to}`].join('\n');
---

<section class="timeline" aria-labelledby="timeline-heading">
  <h2 id="timeline-heading">When groups took on their brands</h2>
  <p class="intro">
    Each dot is a brand, placed at the year the group bought it. A hollow dot with a line is a brand the group has
    since sold or closed.
  </p>
  <div class="frame">
    <div class="scroll">
      <div class="chart">
        <div class="axis" aria-hidden="true">
          <span class="lane-name"></span>
          <span class="before">Earlier</span>
          <span class="track">
            {ticks.map((year) => <span class="tick" style={{ left: at(year) }}>{year}</span>)}
          </span>
        </div>
        <ul class="lanes">
          {
            lanes.map(({ group, marks, rows }) => (
              <li class="lane" style={{ '--rows': rows }}>
                <a class="lane-name" href={href(`/ownership-groups/${group.id}/`)}>
                  {group.data.name}
                </a>
                <span class="before" />
                <span class="track">
                  {ticks.map((year) => (
                    <span class="grid" style={{ left: at(year) }} />
                  ))}
                  {marks.map((mark) => (
                    <>
                      {mark.to !== undefined && (
                        <span
                          class="tenure"
                          style={{ left: at(mark.from), width: `calc(${at(mark.to)} - ${at(mark.from)})`, '--row': mark.row }}
                        />
                      )}
                      <a
                        class:list={['dot', { ended: mark.to !== undefined, early: mark.from < start }]}
                        style={{ left: mark.from < start ? 'calc(-12px - var(--before) / 2)' : at(mark.from), '--row': mark.row }}
                        href={href(`/brands/${mark.brand.id}/`)}
                        aria-label={describe(mark, group).replaceAll('\n', ', ')}
                        data-tip={describe(mark, group)}
                      />
                    </>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="tip" role="presentation" hidden></div>
  </div>
  <p class="note">
    {plural(datedTotal, 'purchase')} with a year on record. {undatedTotal > 0 && `${undatedTotal} more current holdings have no year yet and are left out.`}
  </p>
</section>

<style>
  .timeline {
    --dot: 10px;
    --row-height: 14px;
    --before: 56px;
    --mark: #2a78d6;
    margin: 0 0 40px;
  }

  @media (prefers-color-scheme: dark) {
    .timeline {
      --mark: #5598e7;
    }
  }

  h2 {
    margin: 0 0 4px;
    font-size: 1.25rem;
  }

  .intro,
  .note {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .note {
    margin: 8px 0 0;
  }

  .frame {
    position: relative;
  }

  .scroll {
    overflow-x: auto;
  }

  .chart {
    min-width: 620px;
    padding: 8px 12px 8px 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .axis,
  .lane {
    display: grid;
    grid-template-columns: 150px var(--before) 1fr;
    align-items: center;
  }

  .axis {
    height: 20px;
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .before {
    align-self: stretch;
    text-align: center;
    border-right: 1px dashed var(--line);
  }

  .track {
    position: relative;
    align-self: stretch;
    margin: 0 8px 0 12px;
  }

  .tick {
    position: absolute;
    top: 2px;
    translate: -50% 0;
  }

  .lanes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lane {
    min-height: calc(var(--rows) * var(--row-height) + 10px);
    border-top: 1px solid var(--line);
  }

  .lane-name {
    overflow: hidden;
    padding: 0 10px;
    font-size: 0.8125rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .grid {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--line);
  }

  .dot,
  .tenure {
    position: absolute;
    top: calc(5px + var(--row) * var(--row-height) + (var(--row-height) - var(--dot)) / 2);
  }

  .dot {
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    translate: -50% 0;
    background: var(--mark);
    border: 2px solid var(--surface);
    border-radius: 50%;
    box-sizing: content-box;
    margin-top: -2px;
  }

  .dot.ended {
    background: var(--surface);
    border-color: var(--mark);
    box-sizing: border-box;
    margin-top: 0;
  }

  .dot:hover,
  .dot:focus-visible {
    z-index: 2;
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .tenure {
    height: 2px;
    margin-top: calc(var(--dot) / 2 - 1px);
    background: var(--mark);
  }

  /* A short upright stroke where the holding ended. */
  .tenure::after {
    position: absolute;
    top: -4px;
    right: -1px;
    width: 2px;
    height: 10px;
    content: '';
    background: var(--mark);
  }

  .tip {
    position: absolute;
    z-index: 3;
    padding: 6px 9px;
    color: var(--text);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: pre-line;
    pointer-events: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
  }

  .tip::first-line {
    font-weight: 600;
  }
</style>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.timeline')) {
    const frame = section.querySelector<HTMLElement>('.frame')!;
    const tip = section.querySelector<HTMLElement>('.tip')!;
    const show = (target: HTMLElement) => {
      tip.textContent = target.dataset.tip!;
      tip.hidden = false;
      const bounds = frame.getBoundingClientRect();
      const rect = target.getBoundingClientRect();
      tip.style.left = `${Math.max(4, Math.min(rect.left - bounds.left + 14, bounds.width - tip.offsetWidth - 4))}px`;
      tip.style.top = `${rect.bottom - bounds.top + 6}px`;
    };
    for (const dot of section.querySelectorAll<HTMLElement>('[data-tip]')) {
      dot.addEventListener('pointerenter', () => show(dot));
      dot.addEventListener('focus', () => show(dot));
      dot.addEventListener('pointerleave', () => (tip.hidden = true));
      dot.addEventListener('blur', () => (tip.hidden = true));
    }
  }
</script>
