---
import { href } from '../lib/catalog';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · WatchPocket` : 'WatchPocket';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The names and corporations behind the world's watch brands." />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="wordmark" href={href('/')}>WatchPocket</a>
      <nav>
        <a href={href('/')}>Brands</a>
        <a href={href('/ownership-groups/')}>Ownership Groups</a>
        <a href={href('/countries/')}>Countries</a>
        <a href={href('/references/')}>References</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Sample data only. Not yet verified.</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf9f6;
    --surface: #ffffff;
    --text: #1c1b19;
    --muted: #6b6860;
    --line: #e2dfd7;
    --accent: #8a5a1c;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151412;
      --surface: #1e1d1a;
      --text: #ece9e2;
      --muted: #a09c92;
      --line: #33312c;
      --accent: #d9a55a;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 system-ui, sans-serif;
  }

  header,
  main,
  footer {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  nav a {
    white-space: nowrap;
  }

  main {
    padding-top: 24px;
    padding-bottom: 48px;
  }

  footer {
    padding-bottom: 32px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2 {
    font-family: Georgia, serif;
    font-weight: normal;
    line-height: 1.2;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 2rem;
  }

  .lede {
    margin: 0 0 24px;
    color: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  th,
  td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  th {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  td.num {
    font-variant-numeric: tabular-nums;
  }

  .cap {
    text-transform: capitalize;
  }

  dl.facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 24px;
    margin: 0 0 24px;
  }

  dl.facts dt {
    color: var(--muted);
  }

  dl.facts dd {
    margin: 0;
  }
</style>
