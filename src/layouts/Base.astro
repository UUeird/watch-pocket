---
import { href } from '../lib/catalog';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} · WatchPocket` : 'WatchPocket';
const sections = [
  { path: '/brands/', name: 'Brands' },
  { path: '/ownership-groups/', name: 'Ownership Groups' },
  { path: '/countries/', name: 'Countries' },
  { path: '/references/', name: 'References' },
];
// The section a page belongs to is marked in the nav: the page itself, or "true" for a page within it.
const current = (path: string) => {
  const here = Astro.url.pathname.replace(/\/?$/, '/');
  const target = href(path);
  return here === target ? 'page' : here.startsWith(target) ? 'true' : undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The names and corporations behind the world's watch brands." />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header>
      <a class="wordmark" href={href('/')}>WatchPocket</a>
      <nav>
        {sections.map(({ path, name }) => <a href={href(path)} aria-current={current(path)}>{name}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>Sample data only. Not yet verified.</footer>
  </body>
</html>

<script>
  // Column labels stick just under the site header, so they need its height, which changes as the nav wraps.
  const header = document.querySelector('header')!;
  new ResizeObserver(() => {
    document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
  }).observe(header);

  // A scrolling wrapper holds the labels inside it, so a table that fits drops the scrollbar and its labels stick to the page.
  // One that still has to scroll sideways has its labels slid down to sit under the header as the page scrolls past it.
  const wraps = [...document.querySelectorAll<HTMLElement>('.table-wrap')];
  const lift = () => {
    for (const wrap of wraps) {
      if (wrap.classList.contains('fits')) continue;
      const table = wrap.querySelector('table')!;
      const head = table.tHead!;
      const top = table.getBoundingClientRect().top;
      const room = table.offsetHeight - head.offsetHeight;
      const by = Math.min(Math.max(header.offsetHeight - top, 0), room);
      wrap.style.setProperty('--lift', `${by}px`);
    }
  };
  for (const wrap of wraps) {
    const table = wrap.querySelector('table')!;
    new ResizeObserver(() => {
      wrap.classList.remove('fits');
      wrap.classList.toggle('fits', table.offsetWidth <= wrap.clientWidth);
      lift();
    }).observe(wrap);
  }
  addEventListener('scroll', lift, { passive: true });
</script>

<style is:global>
  :root {
    --bg: #faf9f6;
    --surface: #ffffff;
    --text: #1c1b19;
    --muted: #6b6860;
    --line: #e2dfd7;
    --accent: #8a5a1c;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151412;
      --surface: #1e1d1a;
      --text: #ece9e2;
      --muted: #a09c92;
      --line: #33312c;
      --accent: #d9a55a;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 system-ui, sans-serif;
  }

  /* Everything spans the window up to a wide cap, so the charts have room for more brands in each box. */
  header,
  main,
  footer {
    max-width: 1488px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* The header stays in view while the page scrolls, on the page background so content slides under it. */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .wordmark {
    font-family: Georgia, serif;
    font-size: 1.5rem;
    color: var(--text);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  nav a {
    white-space: nowrap;
  }

  nav a[aria-current] {
    color: var(--text);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  main {
    padding-top: 24px;
    padding-bottom: 48px;
  }

  footer {
    padding-bottom: 32px;
    color: var(--muted);
    font-size: 0.875rem;
  }

  a {
    color: var(--accent);
  }

  h1,
  h2 {
    font-family: Georgia, serif;
    font-weight: normal;
    line-height: 1.2;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 2rem;
  }

  /* Logos are drawn for a light page, so each sits on a white plate in both color schemes. */
  .logo {
    display: block;
    width: auto;
    height: auto;
    max-width: min(240px, 100%);
    max-height: 96px;
    margin: 0 0 4px;
    padding: 12px;
    background: #ffffff;
    border: 1px solid var(--line);
  }

  .logo-credit {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .lede {
    margin: 0 0 24px;
    color: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .table-wrap.fits {
    overflow-x: visible;
  }

  /* A table too wide for the window scrolls sideways, so its labels are slid down by script rather than stuck. */
  .table-wrap:not(.fits) thead th {
    position: relative;
    top: 0;
    transform: translateY(var(--lift, 0));
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  th,
  td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }

  th {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* The column labels stay in view under the site header; their rule is a shadow, since collapsed borders don't travel with them. */
  thead th {
    position: sticky;
    top: var(--header-height, 0);
    z-index: 1;
    background: var(--surface);
    border-bottom: none;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  td.num {
    font-variant-numeric: tabular-nums;
  }

  .cap {
    text-transform: capitalize;
  }

  dl.facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 24px;
    margin: 0 0 24px;
  }

  dl.facts dt {
    color: var(--muted);
  }

  dl.facts dd {
    margin: 0;
  }
</style>
