{
  "name": "watch-pocket",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm run build && npm run test:links && npm run test:browser",
    "test:browser": "playwright test --project=chromium",
    "docs:media": "DOCS=1 npm run build && playwright test --project=docs-media",
    "test:docs": "DOCS=1 npm run build && playwright test --project=chromium tests/docs.spec.ts",
    "test:rules": "scripts/test-data-rules.sh",
    "check:external": "node scripts/check-external.mjs",
    "photos:official": "node scripts/refresh-official-photos.mjs",
    "photos:commons": "node scripts/find-commons-photos.mjs",
    "photos:add": "node scripts/add-model-photo.mjs",
    "photos:review": "node scripts/build-photo-review.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "d3-hierarchy": "^3.1.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.5",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
